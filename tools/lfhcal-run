#!/usr/bin/env python3
"""Run arbitrary LFHCal jobs locally or through HTCondor with provenance."""

from __future__ import annotations

import argparse
import concurrent.futures
import dataclasses
import datetime as dt
import hashlib
import json
import os
import pathlib
import platform
import re
import shlex
import shutil
import socket
import subprocess
import sys
import threading
import time
import uuid
from typing import Any, Sequence


SCHEMA = "lfhcal.run/v1"
ROOT_LOCK = threading.Lock()
ROLE_RE = re.compile(r"^[A-Za-z][A-Za-z0-9_.-]*$")
ENVIRONMENT_NAMES = {
    "PATH",
    "LD_LIBRARY_PATH",
    "DYLD_LIBRARY_PATH",
    "ROOTSYS",
    "ROOT_INCLUDE_PATH",
    "ROOT_VERSION",
    "ROOT_HEADLESS",
    "EIC_SHELL_PREFIX",
    "SINGULARITY_CONTAINER",
    "APPTAINER_CONTAINER",
    "CONDA_DEFAULT_ENV",
}
ENVIRONMENT_PREFIXES = ("LFHCAL_", "_CONDOR_")


@dataclasses.dataclass
class FileRef:
    path: str
    role: str | None = None

    def to_dict(self) -> dict[str, Any]:
        return {"role": self.role, "path": self.path}

    @classmethod
    def from_dict(cls, value: dict[str, Any]) -> "FileRef":
        return cls(path=value["path"], role=value.get("role"))


@dataclasses.dataclass
class JobSpec:
    command: list[str]
    inputs: list[FileRef]
    outputs: list[FileRef]
    name: str | None = None
    cwd: str | None = None
    source_line: int | None = None
    parents: list[str] = dataclasses.field(default_factory=list)
    retries: int = 0

    def to_dict(self) -> dict[str, Any]:
        return {
            "name": self.name,
            "command": self.command,
            "cwd": self.cwd,
            "inputs": [item.to_dict() for item in self.inputs],
            "outputs": [item.to_dict() for item in self.outputs],
            "source_line": self.source_line,
            "parents": self.parents,
            "retries": self.retries,
        }

    @classmethod
    def from_dict(cls, value: dict[str, Any]) -> "JobSpec":
        return cls(
            name=value.get("name"),
            command=list(value["command"]),
            cwd=value.get("cwd"),
            inputs=[FileRef.from_dict(item) for item in value.get("inputs", [])],
            outputs=[FileRef.from_dict(item) for item in value.get("outputs", [])],
            source_line=value.get("source_line"),
            parents=list(value.get("parents", [])),
            retries=int(value.get("retries", 0)),
        )


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec="microseconds")


def new_id(prefix: str) -> str:
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    return f"{prefix}-{stamp}-{uuid.uuid4().hex[:8]}"


def atomic_json(path: pathlib.Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{uuid.uuid4().hex}.tmp")
    temporary.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    temporary.replace(path)


def parse_file_ref(text: str) -> FileRef:
    if "=" in text:
        possible_role, possible_path = text.split("=", 1)
        if ROLE_RE.fullmatch(possible_role):
            if not possible_path:
                raise argparse.ArgumentTypeError(f"missing path after role in {text!r}")
            return FileRef(path=possible_path, role=possible_role)
    if not text:
        raise argparse.ArgumentTypeError("file path may not be empty")
    return FileRef(path=text)


def metadata_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(add_help=False, allow_abbrev=False)
    parser.add_argument("--name")
    parser.add_argument("--cwd")
    parser.add_argument("--input", action="append", default=[], type=parse_file_ref)
    parser.add_argument("--output", action="append", default=[], type=parse_file_ref)
    return parser


def main_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="lfhcal-run",
        allow_abbrev=False,
        description="Run arbitrary commands with reproducible execution metadata.",
        epilog=(
            "Single job: lfhcal-run --input raw=file.root --output result=out.root "
            "-- COMMAND [ARGS...]"
        ),
    )
    parser.add_argument(
        "manifest",
        nargs="?",
        help="job/DAG file containing shell-quoted commands and optional dependencies",
    )
    parser.add_argument("-j", "--jobs", type=int, default=1, help="maximum local jobs at once")
    parser.add_argument("--backend", choices=("local", "condor"), default="local")
    parser.add_argument("--condor", action="store_true", help="alias for --backend condor")
    parser.add_argument("--name", help="single-job name")
    parser.add_argument("--cwd", help="working directory for every job unless overridden")
    parser.add_argument("--input", action="append", default=[], type=parse_file_ref)
    parser.add_argument("--output", action="append", default=[], type=parse_file_ref)
    parser.add_argument(
        "--note",
        action="append",
        default=[],
        metavar="TEXT",
        help="free-form campaign note; repeat as needed",
    )
    parser.add_argument(
        "--provenance-dir",
        default="lfhcal-runs",
        help="campaign record directory (default: lfhcal-runs)",
    )
    parser.add_argument("--dry-run", action="store_true", help="describe work without running/submitting")
    parser.add_argument("--condor-wrapper", help="container/site wrapper placed before the worker command")
    parser.add_argument(
        "--environment-file",
        action="append",
        default=[],
        metavar="FILE",
        help="file copied into the campaign environment archive; repeat as needed",
    )
    parser.add_argument(
        "--container-image",
        metavar="PATH",
        help="container path whose resolved identity is recorded (the image is not copied)",
    )
    parser.add_argument("--request-cpus", type=int, default=1)
    parser.add_argument("--request-memory", default="2GB")
    parser.add_argument("--request-disk", default="2GB")
    parser.add_argument(
        "--condor-extra",
        action="append",
        default=[],
        metavar="KEY=VALUE",
        help="extra submit description entry; repeat as needed",
    )
    return parser


def tokenize_manifest_line(line: str) -> list[str]:
    lexer = shlex.shlex(line, posix=True)
    lexer.whitespace_split = True
    lexer.commenters = "#"
    return list(lexer)


def parse_manifest(path: pathlib.Path, default_cwd: str | None) -> list[JobSpec]:
    jobs: list[JobSpec] = []
    parser = metadata_parser()
    parent_directives: list[tuple[int, list[str], list[str]]] = []
    retry_directives: list[tuple[int, str, int]] = []
    for line_number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
        try:
            tokens = tokenize_manifest_line(line)
        except ValueError as exc:
            raise ValueError(f"{path}:{line_number}: {exc}") from exc
        if not tokens:
            continue
        if tokens[0] == "PARENT":
            if tokens.count("CHILD") != 1:
                raise ValueError(
                    f"{path}:{line_number}: PARENT requires exactly one CHILD keyword"
                )
            child_index = tokens.index("CHILD")
            parents = tokens[1:child_index]
            children = tokens[child_index + 1 :]
            if not parents or not children:
                raise ValueError(
                    f"{path}:{line_number}: PARENT requires parent and child job names"
                )
            parent_directives.append((line_number, parents, children))
            continue
        if tokens[0] == "RETRY":
            if len(tokens) != 3:
                raise ValueError(f"{path}:{line_number}: RETRY requires JOB COUNT")
            try:
                retries = int(tokens[2])
            except ValueError as exc:
                raise ValueError(
                    f"{path}:{line_number}: RETRY count must be an integer"
                ) from exc
            if retries < 0:
                raise ValueError(f"{path}:{line_number}: RETRY count may not be negative")
            retry_directives.append((line_number, tokens[1], retries))
            continue
        forced_name: str | None = None
        if tokens[0] == "JOB":
            if len(tokens) < 4 or "--" not in tokens[2:]:
                raise ValueError(
                    f"{path}:{line_number}: JOB requires NAME -- COMMAND [ARGS...]"
                )
            forced_name = tokens[1]
            if not ROLE_RE.fullmatch(forced_name):
                raise ValueError(f"{path}:{line_number}: invalid job name {forced_name!r}")
            tokens = tokens[2:]
        if "--" in tokens:
            delimiter = tokens.index("--")
            metadata = parser.parse_args(tokens[:delimiter])
            command = tokens[delimiter + 1 :]
        else:
            metadata = parser.parse_args([])
            command = tokens
        if not command:
            raise ValueError(f"{path}:{line_number}: no command after --")
        if forced_name and metadata.name and metadata.name != forced_name:
            raise ValueError(
                f"{path}:{line_number}: JOB name and --name must be identical"
            )
        jobs.append(
            JobSpec(
                name=forced_name or metadata.name,
                command=command,
                cwd=metadata.cwd or default_cwd,
                inputs=metadata.input,
                outputs=metadata.output,
                source_line=line_number,
            )
        )
    if not jobs:
        raise ValueError(f"{path}: contains no jobs")
    apply_graph_directives(path, jobs, parent_directives, retry_directives)
    return jobs


def apply_graph_directives(
    path: pathlib.Path,
    jobs: list[JobSpec],
    parent_directives: Sequence[tuple[int, list[str], list[str]]],
    retry_directives: Sequence[tuple[int, str, int]],
) -> None:
    if not parent_directives and not retry_directives:
        return
    unnamed = [index for index, job in enumerate(jobs) if not job.name]
    if unnamed:
        lines = ", ".join(str(jobs[index].source_line) for index in unnamed)
        raise ValueError(f"{path}: DAG jobs require names; unnamed job lines: {lines}")
    jobs_by_name: dict[str, JobSpec] = {}
    for job in jobs:
        assert job.name is not None
        if job.name in jobs_by_name:
            raise ValueError(f"{path}: duplicate DAG job name {job.name!r}")
        jobs_by_name[job.name] = job
    for line_number, parents, children in parent_directives:
        for name in parents + children:
            if name not in jobs_by_name:
                raise ValueError(f"{path}:{line_number}: unknown DAG job {name!r}")
        for child in children:
            child_job = jobs_by_name[child]
            for parent in parents:
                if parent == child:
                    raise ValueError(
                        f"{path}:{line_number}: job {child!r} cannot depend on itself"
                    )
                if parent not in child_job.parents:
                    child_job.parents.append(parent)
    for line_number, name, retries in retry_directives:
        if name not in jobs_by_name:
            raise ValueError(f"{path}:{line_number}: unknown DAG job {name!r}")
        jobs_by_name[name].retries = retries
    validate_acyclic_graph(path, jobs, jobs_by_name)


def validate_acyclic_graph(
    path: pathlib.Path, jobs: Sequence[JobSpec], jobs_by_name: dict[str, JobSpec]
) -> None:
    children: dict[str, list[str]] = {name: [] for name in jobs_by_name}
    remaining_parents = {job.name: len(job.parents) for job in jobs if job.name}
    for job in jobs:
        assert job.name is not None
        for parent in job.parents:
            children[parent].append(job.name)
    ready = [name for name, count in remaining_parents.items() if count == 0]
    visited = 0
    while ready:
        parent = ready.pop()
        visited += 1
        for child in children[parent]:
            remaining_parents[child] -= 1
            if remaining_parents[child] == 0:
                ready.append(child)
    if visited != len(jobs_by_name):
        cyclic = sorted(name for name, count in remaining_parents.items() if count)
        raise ValueError(f"{path}: dependency cycle involving {', '.join(cyclic)}")


def is_dag_campaign(jobs: Sequence[JobSpec]) -> bool:
    return any(job.parents or job.retries for job in jobs)


def split_invocation(argv: Sequence[str]) -> tuple[list[str], list[str] | None]:
    values = list(argv)
    if "--" not in values:
        return values, None
    delimiter = values.index("--")
    return values[:delimiter], values[delimiter + 1 :]


def logical_cwd() -> pathlib.Path:
    """Return the shell's logical working directory when it names this directory."""
    physical = pathlib.Path.cwd()
    shell_pwd = os.environ.get("PWD")
    if not shell_pwd:
        return physical
    candidate = pathlib.Path(shell_pwd).expanduser()
    if not candidate.is_absolute():
        return physical
    try:
        if os.path.samefile(candidate, physical):
            return pathlib.Path(os.path.normpath(str(candidate)))
    except OSError:
        pass
    return physical


def normalized_path(text: str, cwd: pathlib.Path) -> pathlib.Path:
    path = pathlib.Path(text).expanduser()
    if not path.is_absolute():
        path = cwd / path
    # Deliberately avoid resolving symlinks.  At BNL, /star/u/... may resolve to
    # /direct/star+u/..., but the logical path is the one shared with containers
    # and execute nodes.
    return pathlib.Path(os.path.abspath(path))


def logical_invocation_path(text: str, cwd: pathlib.Path) -> pathlib.Path:
    """Map an absolute path beneath the physical cwd back beneath the logical cwd."""
    path = pathlib.Path(text).expanduser()
    if not path.is_absolute():
        return normalized_path(text, cwd)
    try:
        relative = path.relative_to(pathlib.Path.cwd())
    except ValueError:
        return normalized_path(text, cwd)
    return normalized_path(str(relative), cwd)


def inspect_file(item: FileRef, cwd: pathlib.Path) -> dict[str, Any]:
    path = normalized_path(item.path, cwd)
    result: dict[str, Any] = {"role": item.role, "path": str(path)}
    try:
        stat = path.stat()
    except OSError as exc:
        result.update({"exists": False, "stat_error": str(exc)})
        return result
    result.update(
        {
            "exists": True,
            "kind": "directory" if path.is_dir() else "file",
            "size_bytes": stat.st_size,
            "mtime_ns": stat.st_mtime_ns,
        }
    )
    return result


def run_capture(command: Sequence[str], cwd: pathlib.Path | None = None) -> str | None:
    try:
        result = subprocess.run(
            command,
            cwd=cwd,
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    return result.stdout.strip()


def sha256_file(path: pathlib.Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
    return f"sha256:{digest.hexdigest()}"


def archive_file(
    source_text: str,
    destination: pathlib.Path,
    cwd: pathlib.Path,
) -> dict[str, Any]:
    source = normalized_path(source_text, cwd)
    if not source.is_file():
        raise ValueError(f"environment file does not exist or is not a file: {source}")
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(source, destination)
    stat = destination.stat()
    return {
        "source_path": str(source),
        "archived_path": str(destination),
        "sha256": sha256_file(destination),
        "size_bytes": stat.st_size,
        "mode": oct(stat.st_mode & 0o7777),
    }


def digest_from_cvmfs_image_path(path: str) -> str | None:
    match = re.search(
        r"/\.images/sha256:(?:([0-9a-fA-F]{2})/([0-9a-fA-F]{62})|"
        r"([0-9a-fA-F]{64}))(?:/|$)",
        path,
    )
    if not match:
        return None
    value = match.group(3) or f"{match.group(1)}{match.group(2)}"
    return f"sha256:{value.lower()}"


def container_path_record(path_text: str, cwd: pathlib.Path) -> dict[str, Any]:
    path = normalized_path(path_text, cwd)
    result: dict[str, Any] = {
        "path": str(path),
        "exists": path.exists(),
        "is_symlink": path.is_symlink(),
    }
    if path.is_symlink():
        try:
            result["symlink_target"] = os.readlink(path)
        except OSError as exc:
            result["symlink_error"] = str(exc)
    resolved = pathlib.Path(os.path.realpath(path))
    result["resolved_path"] = str(resolved)
    digest = digest_from_cvmfs_image_path(str(resolved))
    if digest:
        result["content_digest"] = digest
    return result


def active_container_record(cwd: pathlib.Path) -> dict[str, Any] | None:
    variables = {
        name: os.environ[name]
        for name in ("APPTAINER_CONTAINER", "SINGULARITY_CONTAINER")
        if os.environ.get(name)
    }
    if not variables:
        return None
    selected = variables.get("APPTAINER_CONTAINER") or variables["SINGULARITY_CONTAINER"]
    record = container_path_record(selected, cwd)
    record["environment_variables"] = variables
    for runtime in ("apptainer", "singularity"):
        executable = shutil.which(runtime)
        if executable:
            record["runtime"] = {
                "command": executable,
                "version": run_capture((executable, "--version")),
            }
            break
    return record


def git_record(path: pathlib.Path) -> dict[str, Any] | None:
    start = path if path.is_dir() else path.parent
    root_text = run_capture(("git", "-C", str(start), "rev-parse", "--show-toplevel"))
    if not root_text:
        return None
    root = pathlib.Path(root_text)
    commit = run_capture(("git", "-C", str(root), "rev-parse", "HEAD"))
    branch = run_capture(("git", "-C", str(root), "branch", "--show-current"))
    status = run_capture(
        ("git", "-C", str(root), "status", "--porcelain", "--untracked-files=no")
    )
    submodules = run_capture(("git", "-C", str(root), "submodule", "status", "--recursive"))
    return {
        "root": str(root),
        "commit": commit,
        "branch": branch or None,
        "tracked_files_modified": bool(status),
        "submodules": submodules.splitlines() if submodules else [],
    }


def cpu_model() -> str | None:
    if pathlib.Path("/proc/cpuinfo").is_file():
        try:
            for line in pathlib.Path("/proc/cpuinfo").read_text(errors="replace").splitlines():
                if line.lower().startswith("model name"):
                    return line.split(":", 1)[1].strip()
        except OSError:
            pass
    return platform.processor() or None


def execution_environment() -> dict[str, str]:
    return {
        key: value
        for key, value in sorted(os.environ.items())
        if key in ENVIRONMENT_NAMES or key.startswith(ENVIRONMENT_PREFIXES)
    }


def host_record() -> dict[str, Any]:
    return {
        "hostname": socket.gethostname(),
        "platform": platform.platform(),
        "machine": platform.machine(),
        "cpu_model": cpu_model(),
        "logical_cpus": os.cpu_count(),
        "python": platform.python_version(),
        "python_executable": sys.executable,
    }


def root_module() -> tuple[Any | None, str | None]:
    try:
        import ROOT  # type: ignore

        ROOT.gROOT.SetBatch(True)
        return ROOT, None
    except Exception as exc:
        return None, str(exc)


def write_root_record(path: pathlib.Path, record: dict[str, Any], update: bool) -> str | None:
    with ROOT_LOCK:
        ROOT, error = root_module()
        if ROOT is None:
            return f"PyROOT unavailable: {error}"
        mode = "UPDATE" if update else "RECREATE"
        root_file = ROOT.TFile.Open(str(path), mode)
        if not root_file or root_file.IsZombie():
            return f"could not open ROOT file in {mode} mode: {path}"
        try:
            directory = root_file.GetDirectory("LFHCalProvenance")
            if not directory:
                directory = root_file.mkdir("LFHCalProvenance")
            directory.cd()
            payload = ROOT.TObjString(json.dumps(record, sort_keys=True))
            payload.Write("lfhcal_run", ROOT.TObject.kOverwrite)
        except Exception as exc:
            return f"failed writing ROOT provenance to {path}: {exc}"
        finally:
            root_file.Close()
        return None


def run_payload(
    command: Sequence[str],
    cwd: pathlib.Path,
    stdout_path: pathlib.Path,
    stderr_path: pathlib.Path,
    stream_output: bool,
) -> int:
    if not stream_output:
        with stdout_path.open("wb") as stdout_file, stderr_path.open("wb") as stderr_file:
            return subprocess.run(
                command,
                cwd=cwd,
                stdout=stdout_file,
                stderr=stderr_file,
                check=False,
            ).returncode

    with stdout_path.open("wb") as stdout_file, stderr_path.open("wb") as stderr_file:
        process = subprocess.Popen(
            command,
            cwd=cwd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )

        def copy_stream(source: Any, log_file: Any, display: Any) -> None:
            try:
                for chunk in iter(lambda: os.read(source.fileno(), 65536), b""):
                    log_file.write(chunk)
                    log_file.flush()
                    display.write(chunk)
                    display.flush()
            finally:
                source.close()

        stdout_thread = threading.Thread(
            target=copy_stream,
            args=(process.stdout, stdout_file, sys.stdout.buffer),
            daemon=True,
        )
        stderr_thread = threading.Thread(
            target=copy_stream,
            args=(process.stderr, stderr_file, sys.stderr.buffer),
            daemon=True,
        )
        stdout_thread.start()
        stderr_thread.start()
        exit_code = process.wait()
        stdout_thread.join()
        stderr_thread.join()
        return exit_code


def job_label(index: int, job: JobSpec) -> str:
    name = job.name or pathlib.Path(job.command[0]).name or "job"
    slug = re.sub(r"[^A-Za-z0-9_.-]+", "-", name).strip("-.") or "job"
    return f"{index:04d}-{slug}"


def executable_path(command: str, cwd: pathlib.Path) -> pathlib.Path | None:
    if "/" in command:
        candidate = normalized_path(command, cwd)
        return candidate if candidate.exists() else None
    found = shutil.which(command)
    return normalized_path(found, cwd) if found else None


def execute_job(
    job: JobSpec,
    index: int,
    campaign_id: str,
    campaign_dir: pathlib.Path,
    invocation_cwd: pathlib.Path,
    dry_run: bool = False,
    stream_output: bool = False,
) -> dict[str, Any]:
    cwd = normalized_path(job.cwd, invocation_cwd) if job.cwd else invocation_cwd
    attempt_id = new_id("attempt")
    attempt_dir = campaign_dir / "jobs" / job_label(index, job) / "attempts" / attempt_id
    attempt_dir.mkdir(parents=True, exist_ok=True)
    started_at = utc_now()
    started_clock = time.monotonic()
    executable = executable_path(job.command[0], cwd)
    repositories: list[dict[str, Any]] = []
    for candidate in (cwd, executable):
        if candidate is None:
            continue
        info = git_record(candidate)
        if info and all(existing["root"] != info["root"] for existing in repositories):
            repositories.append(info)
    record: dict[str, Any] = {
        "schema": SCHEMA,
        "kind": "execution_attempt",
        "campaign_id": campaign_id,
        "job_index": index,
        "job_name": job.name,
        "attempt_id": attempt_id,
        "source_line": job.source_line,
        "command": {"argv": job.command, "display": shlex.join(job.command)},
        "cwd": str(cwd),
        "inputs": [inspect_file(item, cwd) for item in job.inputs],
        "declared_outputs_before": [inspect_file(item, cwd) for item in job.outputs],
        "host": host_record(),
        "environment": execution_environment(),
        "git": repositories,
        "started_at": started_at,
        "backend": "condor" if os.environ.get("LFHCAL_CONDOR_JOB_ID") else "local",
        "dry_run": dry_run,
    }
    container = active_container_record(cwd)
    if container:
        record["container"] = container
    atomic_json(attempt_dir / "provenance.json", record)
    if dry_run:
        exit_code = 0
    else:
        stdout_path = attempt_dir / "stdout.log"
        stderr_path = attempt_dir / "stderr.log"
        print(f"[{index}] starting: {shlex.join(job.command)}", flush=True)
        try:
            exit_code = run_payload(
                job.command, cwd, stdout_path, stderr_path, stream_output
            )
        except OSError as exc:
            stderr_path.write_text(f"lfhcal-run: could not launch command: {exc}\n", encoding="utf-8")
            exit_code = 127
        print(f"[{index}] finished with exit {exit_code}; logs: {attempt_dir}", flush=True)
    record.update(
        {
            "ended_at": utc_now(),
            "duration_seconds": time.monotonic() - started_clock,
            "exit_code": exit_code,
            "outputs": [inspect_file(item, cwd) for item in job.outputs],
        }
    )
    warnings: list[str] = []
    atomic_json(attempt_dir / "provenance.json", record)
    root_sidecar = attempt_dir / "provenance.root"
    root_error = write_root_record(root_sidecar, record, update=False)
    if root_error:
        warnings.append(root_error)
    if exit_code == 0:
        for item in job.outputs:
            output = normalized_path(item.path, cwd)
            if output.suffix.lower() == ".root" and output.is_file():
                error = write_root_record(output, record, update=True)
                if error:
                    warnings.append(error)
    if warnings:
        record["provenance_warnings"] = warnings
        atomic_json(attempt_dir / "provenance.json", record)
    latest = campaign_dir / "jobs" / job_label(index, job) / "latest.json"
    atomic_json(latest, record)
    return record


def create_campaign(
    jobs: list[JobSpec], args: argparse.Namespace, invocation_cwd: pathlib.Path
) -> tuple[str, pathlib.Path, dict[str, Any]]:
    campaign_id = new_id("campaign")
    base = normalized_path(args.provenance_dir, invocation_cwd)
    campaign_dir = base / campaign_id
    campaign = {
        "schema": SCHEMA,
        "kind": "campaign",
        "campaign_id": campaign_id,
        "created_at": utc_now(),
        "created_from": str(invocation_cwd),
        "backend": "condor" if args.condor else args.backend,
        "max_parallel": args.jobs,
        "jobs": [job.to_dict() for job in jobs],
        "status": "planned" if args.dry_run else "created",
    }
    if args.note:
        campaign["notes"] = list(args.note)
    if is_dag_campaign(jobs):
        campaign["dag"] = {
            "dependencies": [
                {"parent": parent, "child": job.name}
                for job in jobs
                for parent in job.parents
            ],
            "retries": {
                job.name: job.retries for job in jobs if job.retries and job.name
            },
        }
    environment: dict[str, Any] = {}
    if args.container_image:
        image = container_path_record(args.container_image, invocation_cwd)
        if not image["exists"]:
            raise ValueError(f"container image does not exist: {image['path']}")
        environment["container_image"] = image
    if args.environment_file:
        archived_files = []
        for index, source in enumerate(args.environment_file):
            name = pathlib.Path(source).name or "environment-file"
            destination = campaign_dir / "environment" / "files" / f"{index:03d}-{name}"
            archived_files.append(archive_file(source, destination, invocation_cwd))
        environment["archived_files"] = archived_files
    if environment:
        campaign["execution_environment"] = environment
    atomic_json(campaign_dir / "campaign.json", campaign)
    return campaign_id, campaign_dir, campaign


def execute_local_job_with_retries(
    job: JobSpec,
    index: int,
    campaign_id: str,
    campaign_dir: pathlib.Path,
    invocation_cwd: pathlib.Path,
    stream_output: bool,
) -> dict[str, Any]:
    record: dict[str, Any] | None = None
    for retry_number in range(job.retries + 1):
        record = execute_job(
            job,
            index,
            campaign_id,
            campaign_dir,
            invocation_cwd,
            False,
            stream_output,
        )
        if int(record["exit_code"]) == 0:
            return record
        if retry_number < job.retries:
            print(
                f"[{index}] retry {retry_number + 1} of {job.retries} after "
                f"exit {record['exit_code']}",
                flush=True,
            )
    assert record is not None
    return record


def run_local(
    jobs: list[JobSpec],
    args: argparse.Namespace,
    campaign_id: str,
    campaign_dir: pathlib.Path,
    campaign: dict[str, Any],
    invocation_cwd: pathlib.Path,
) -> int:
    if args.jobs < 1:
        raise ValueError("--jobs must be at least 1")
    if args.dry_run:
        for index, job in enumerate(jobs):
            details = []
            if job.parents:
                details.append(f"after {', '.join(job.parents)}")
            if job.retries:
                details.append(f"retry {job.retries}")
            suffix = f" ({'; '.join(details)})" if details else ""
            print(f"[{index}] {shlex.join(job.command)}{suffix}")
        campaign.update({"status": "dry_run", "ended_at": utc_now()})
        atomic_json(campaign_dir / "campaign.json", campaign)
        return 0
    records: list[dict[str, Any] | None] = [None] * len(jobs)
    states = ["pending"] * len(jobs)
    names = {job.name: index for index, job in enumerate(jobs) if job.name}
    parent_indexes = {
        index: [names[parent] for parent in job.parents]
        for index, job in enumerate(jobs)
    }
    pending = set(range(len(jobs)))
    successful: set[int] = set()
    failed: set[int] = set()
    blocked: set[int] = set()
    with concurrent.futures.ThreadPoolExecutor(max_workers=args.jobs) as executor:
        futures: dict[concurrent.futures.Future[dict[str, Any]], int] = {}
        while pending or futures:
            for index in sorted(tuple(pending)):
                parents = parent_indexes[index]
                if any(parent in failed or parent in blocked for parent in parents):
                    pending.remove(index)
                    blocked.add(index)
                    states[index] = "blocked"
                    print(f"[{index}] blocked: a parent job failed", flush=True)
            available = args.jobs - len(futures)
            if available:
                ready = [
                    index
                    for index in sorted(pending)
                    if all(parent in successful for parent in parent_indexes[index])
                ]
                for index in ready[:available]:
                    pending.remove(index)
                    states[index] = "running"
                    future = executor.submit(
                        execute_local_job_with_retries,
                        jobs[index],
                        index,
                        campaign_id,
                        campaign_dir,
                        invocation_cwd,
                        len(jobs) == 1,
                    )
                    futures[future] = index
            if not futures:
                if pending:
                    raise ValueError("dependency scheduler could not find a runnable job")
                break
            completed, _ = concurrent.futures.wait(
                futures, return_when=concurrent.futures.FIRST_COMPLETED
            )
            for future in completed:
                index = futures.pop(future)
                record = future.result()
                records[index] = record
                if int(record["exit_code"]) == 0:
                    successful.add(index)
                    states[index] = "completed"
                else:
                    failed.add(index)
                    states[index] = "failed"
    exit_codes = [int(record["exit_code"]) for record in records if record is not None]
    failed_count = len(failed)
    campaign.update(
        {
            "status": "failed" if failed_count or blocked else "completed",
            "ended_at": utc_now(),
            "completed_jobs": len(exit_codes),
            "failed_jobs": failed_count,
            "blocked_jobs": len(blocked),
            "job_statuses": [
                {"index": index, "name": job.name, "status": states[index]}
                for index, job in enumerate(jobs)
            ],
        }
    )
    atomic_json(campaign_dir / "campaign.json", campaign)
    return next((code for code in exit_codes if code != 0), 0)


def validate_condor_extra(entries: Sequence[str]) -> list[tuple[str, str]]:
    result: list[tuple[str, str]] = []
    for entry in entries:
        if "=" not in entry:
            raise ValueError(f"--condor-extra requires KEY=VALUE, got {entry!r}")
        key, value = entry.split("=", 1)
        key = key.strip()
        if not re.fullmatch(r"[A-Za-z][A-Za-z0-9_.]*", key):
            raise ValueError(f"invalid Condor submit key: {key!r}")
        if "\n" in value or "\r" in value:
            raise ValueError("Condor submit values may not contain newlines")
        result.append((key, value.strip()))
    return result


def submit_condor(
    jobs: list[JobSpec],
    args: argparse.Namespace,
    campaign_id: str,
    campaign_dir: pathlib.Path,
    campaign: dict[str, Any],
    invocation_cwd: pathlib.Path,
) -> int:
    dag_campaign = is_dag_campaign(jobs)
    tool = logical_invocation_path(__file__, invocation_cwd)
    worker = campaign_dir / "condor_worker.sh"
    worker_python = "python3" if args.condor_wrapper else sys.executable
    worker_text = (
        "#!/usr/bin/env bash\n"
        "set -u\n"
        f"exec {shlex.quote(worker_python)} {shlex.quote(str(tool))} _worker "
        f"--campaign {shlex.quote(str(campaign_dir / 'campaign.json'))} "
        '"$1"\n'
    )
    worker.write_text(worker_text, encoding="utf-8")
    worker.chmod(0o755)
    condor_dir = campaign_dir / "condor"
    condor_dir.mkdir(parents=True, exist_ok=True)
    executable = worker
    if args.condor_wrapper:
        source_wrapper = normalized_path(args.condor_wrapper, invocation_cwd)
        if not source_wrapper.is_file():
            raise ValueError(f"Condor wrapper does not exist: {source_wrapper}")
        wrapper_name = f"condor-wrapper{source_wrapper.suffix}"
        executable = campaign_dir / "environment" / wrapper_name
        wrapper_record = archive_file(str(source_wrapper), executable, invocation_cwd)
        campaign.setdefault("execution_environment", {})["condor_wrapper"] = wrapper_record
        atomic_json(campaign_dir / "campaign.json", campaign)
    job_index = "$(lfhcal_job_index)" if dag_campaign else "$(Process)"
    arguments = f'"{worker} {job_index}"' if args.condor_wrapper else job_index
    environment_assignments = [
        "LFHCAL_BATCH_SYSTEM=condor",
        "LFHCAL_CONDOR_CLUSTER=$(ClusterId)",
        "LFHCAL_CONDOR_PROCESS=$(ProcId)",
        "LFHCAL_CONDOR_JOB_ID=$(ClusterId).$(ProcId)",
    ]
    if dag_campaign:
        environment_assignments.append("LFHCAL_CONDOR_DAG_NODE=$(lfhcal_node)")
    container = campaign.get("execution_environment", {}).get("container_image")
    if container:
        container_execution_path = container["resolved_path"]
        if re.search(r'[\s"]', container_execution_path):
            raise ValueError("resolved container image path may not contain whitespace or quotes")
        environment_assignments.append(
            f"LFHCAL_CONTAINER_IMAGE={container_execution_path}"
        )
    output_name = "$(lfhcal_node)" if dag_campaign else "$(Process)"
    submit_lines = [
        "universe = vanilla",
        f"executable = {executable}",
        f"arguments = {arguments}",
        "getenv = True",
        f'environment = "{" ".join(environment_assignments)}"',
        f"request_cpus = {args.request_cpus}",
        f"request_memory = {args.request_memory}",
        f"request_disk = {args.request_disk}",
        f"log = {condor_dir}/campaign.log",
        f"output = {condor_dir}/{output_name}.out",
        f"error = {condor_dir}/{output_name}.err",
        "should_transfer_files = NO",
    ]
    submit_lines.extend(f"{key} = {value}" for key, value in validate_condor_extra(args.condor_extra))
    submit_lines.append(f"queue {1 if dag_campaign else len(jobs)}")
    submit_path = campaign_dir / "condor.sub"
    submit_path.write_text("\n".join(submit_lines) + "\n", encoding="utf-8")
    dag_path: pathlib.Path | None = None
    if dag_campaign:
        dag_lines = []
        for index, job in enumerate(jobs):
            assert job.name is not None
            dag_lines.extend(
                [
                    f"JOB {job.name} {submit_path}",
                    f'VARS {job.name} lfhcal_job_index="{index}" '
                    f'lfhcal_node="{job.name}"',
                ]
            )
            if job.retries:
                dag_lines.append(f"RETRY {job.name} {job.retries}")
        for job in jobs:
            assert job.name is not None
            if job.parents:
                dag_lines.append(
                    f"PARENT {' '.join(job.parents)} CHILD {job.name}"
                )
        dag_path = campaign_dir / "campaign.dag"
        dag_path.write_text("\n".join(dag_lines) + "\n", encoding="utf-8")
    if args.dry_run:
        print(submit_path.read_text(encoding="utf-8"), end="")
        if dag_path:
            print(dag_path.read_text(encoding="utf-8"), end="")
        campaign.update(
            {
                "status": "dry_run",
                "condor_submit_file": str(submit_path),
                **({"condor_dag_file": str(dag_path)} if dag_path else {}),
            }
        )
        atomic_json(campaign_dir / "campaign.json", campaign)
        return 0
    submit_command = (
        ("condor_submit_dag", str(dag_path))
        if dag_path
        else ("condor_submit", str(submit_path))
    )
    if shutil.which(submit_command[0]) is None:
        error = (
            f"{submit_command[0]} not found. Submit from an HTCondor host outside the "
            "analysis container; use --condor-wrapper to enter the container "
            "on execute nodes"
        )
        campaign.update(
            {
                "status": "submit_failed",
                "condor_submit_file": str(submit_path),
                **({"condor_dag_file": str(dag_path)} if dag_path else {}),
                "error": error,
            }
        )
        atomic_json(campaign_dir / "campaign.json", campaign)
        retained_path = dag_path or submit_path
        print(
            f"lfhcal-run: {error}; submission files retained at {retained_path}",
            file=sys.stderr,
        )
        return 127
    result = subprocess.run(
        submit_command,
        cwd=invocation_cwd,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    campaign.update(
        {
            "status": "submitted" if result.returncode == 0 else "submit_failed",
            "submitted_at": utc_now(),
            "condor_submit_file": str(submit_path),
            **({"condor_dag_file": str(dag_path)} if dag_path else {}),
            "condor_submit_command": list(submit_command),
            "condor_submit_stdout": result.stdout,
            "condor_submit_stderr": result.stderr,
            "condor_submit_exit_code": result.returncode,
        }
    )
    atomic_json(campaign_dir / "campaign.json", campaign)
    return result.returncode


def worker_main(argv: Sequence[str]) -> int:
    parser = argparse.ArgumentParser(prog="lfhcal-run _worker", allow_abbrev=False)
    parser.add_argument("--campaign", required=True)
    parser.add_argument("index", type=int)
    args = parser.parse_args(argv)
    campaign_path = normalized_path(args.campaign, logical_cwd())
    campaign = json.loads(campaign_path.read_text(encoding="utf-8"))
    jobs = [JobSpec.from_dict(item) for item in campaign["jobs"]]
    if args.index < 0 or args.index >= len(jobs):
        parser.error(f"job index {args.index} is out of range")
    record = execute_job(
        jobs[args.index],
        args.index,
        campaign["campaign_id"],
        campaign_path.parent,
        pathlib.Path(campaign["created_from"]),
        stream_output=True,
    )
    return int(record["exit_code"])


def main(argv: Sequence[str] | None = None) -> int:
    values = list(sys.argv[1:] if argv is None else argv)
    if values and values[0] == "_worker":
        return worker_main(values[1:])
    runner_values, payload = split_invocation(values)
    parser = main_parser()
    args = parser.parse_args(runner_values)
    if args.condor:
        args.backend = "condor"
    invocation_cwd = logical_cwd()
    try:
        if payload is not None:
            if args.manifest:
                parser.error("a manifest and a command after -- are mutually exclusive")
            if not payload:
                parser.error("no command after --")
            jobs = [
                JobSpec(
                    name=args.name,
                    command=payload,
                    cwd=args.cwd,
                    inputs=args.input,
                    outputs=args.output,
                )
            ]
        else:
            if not args.manifest:
                parser.error("provide a manifest or a command after --")
            if args.input or args.output or args.name:
                parser.error("put --name/--input/--output on each manifest line before its --")
            manifest = normalized_path(args.manifest, invocation_cwd)
            jobs = parse_manifest(manifest, args.cwd)
        campaign_id, campaign_dir, campaign = create_campaign(jobs, args, invocation_cwd)
        print(f"Campaign record: {campaign_dir}")
        if not any(job.inputs or job.outputs for job in jobs):
            print(
                "No file lineage was declared. For richer provenance, use "
                "--input [ROLE=]FILE and --output [ROLE=]FILE before --."
            )
        if args.backend == "condor":
            return submit_condor(
                jobs, args, campaign_id, campaign_dir, campaign, invocation_cwd
            )
        return run_local(jobs, args, campaign_id, campaign_dir, campaign, invocation_cwd)
    except (OSError, ValueError) as exc:
        parser.error(str(exc))
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
