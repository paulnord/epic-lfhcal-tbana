#!/usr/bin/env python3
"""Generate an end-to-end TB2026 parameter-scan calibration DAG."""

from __future__ import annotations

import argparse
import os
import pathlib
import shlex
import sys
from collections.abc import Sequence


def logical_cwd() -> pathlib.Path:
    physical = pathlib.Path.cwd()
    shell_pwd = os.environ.get("PWD")
    if shell_pwd:
        candidate = pathlib.Path(shell_pwd).expanduser()
        try:
            if candidate.is_absolute() and os.path.samefile(candidate, physical):
                return pathlib.Path(os.path.normpath(str(candidate)))
        except OSError:
            pass
    return physical


def absolute_path(value: str | pathlib.Path, base: pathlib.Path) -> pathlib.Path:
    path = pathlib.Path(value).expanduser()
    if not path.is_absolute():
        path = base / path
    # Preserve logical /star paths instead of resolving them to /direct paths.
    return pathlib.Path(os.path.abspath(path))


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(
        description=(
            "Generate raw conversion -> pedestal/muon calibration -> waveform "
            "analysis jobs for one TB2026 parameter-scan pair."
        )
    )
    result.add_argument("--pedestal-run", type=int, default=296)
    result.add_argument("--muon-run", type=int, default=298)
    result.add_argument("--raw-dir", required=True, help="directory containing RunNNN.h2g")
    result.add_argument("--output-dir", required=True, help="new campaign product directory")
    result.add_argument("--manifest", required=True, help="manifest file to create")
    result.add_argument(
        "--repository",
        default=str(logical_cwd()),
        help="epic-lfhcal-tbana checkout (default: logical current directory)",
    )
    result.add_argument("--build-dir", help="directory containing Convert, DataPrep, HGCROCStudy")
    result.add_argument("--mapping", help="override the TB2026 V2 mapping")
    result.add_argument("--run-database", help="override the TB2026 run database")
    result.add_argument("--bad-channels", help="override the parameter-scan bad-channel map")
    result.add_argument("--toa-offsets", help="override the Set-1 ToA offsets")
    result.add_argument("--active-cells", help="override the parameter-scan active-cell list")
    result.add_argument(
        "--check",
        action="store_true",
        help="require executables, configuration, and both raw input files to exist",
    )
    result.add_argument("--force", action="store_true", help="replace an existing manifest")
    return result


def job_line(
    name: str,
    command: Sequence[str | pathlib.Path],
    *,
    inputs: Sequence[tuple[str, pathlib.Path]] = (),
    outputs: Sequence[tuple[str, pathlib.Path]] = (),
) -> str:
    tokens: list[str] = ["JOB", name]
    for role, path in inputs:
        tokens.extend(("--input", f"{role}={path}"))
    for role, path in outputs:
        tokens.extend(("--output", f"{role}={path}"))
    tokens.append("--")
    tokens.extend(str(item) for item in command)
    return shlex.join(tokens)


def generate(args: argparse.Namespace) -> tuple[str, list[pathlib.Path]]:
    base = logical_cwd()
    repository = absolute_path(args.repository, base)
    raw_dir = absolute_path(args.raw_dir, base)
    output_dir = absolute_path(args.output_dir, base)
    build_dir = absolute_path(args.build_dir, base) if args.build_dir else repository / "NewStructure/build"

    mapping = absolute_path(args.mapping, base) if args.mapping else repository / "configs/TB2026/mapping_HGCROC_SPSH2TB_sumV2_default.csv"
    run_database = absolute_path(args.run_database, base) if args.run_database else repository / "configs/TB2026/DataTakingDB_TBSPSH2_202605_HGCROC.csv"
    bad_channels = absolute_path(args.bad_channels, base) if args.bad_channels else repository / "configs/TB2026/badChannel_HGCROC_SPSTB2026_OnlyCenter2x4.txt"
    toa_offsets = absolute_path(args.toa_offsets, base) if args.toa_offsets else repository / "configs/TB2026/ToAOffsets_TBSPS2026_ParamScan_1.csv"
    active_cells = absolute_path(args.active_cells, base) if args.active_cells else repository / "configs/TB2026/activeCellsHGCROCParameterScan.txt"

    convert = build_dir / "Convert"
    data_prep = build_dir / "DataPrep"
    hgcroc_study = build_dir / "HGCROCStudy"
    pedestal_run = str(args.pedestal_run)
    muon_run = str(args.muon_run)
    raw_pedestal_h2g = raw_dir / f"Run{pedestal_run}.h2g"
    raw_muon_h2g = raw_dir / f"Run{muon_run}.h2g"

    raw_pedestal = output_dir / f"rawHGCROC_{pedestal_run}.root"
    raw_muon = output_dir / f"rawHGCROC_{muon_run}.root"
    pedestal = output_dir / f"rawHGCROC_wPed_{pedestal_run}.root"
    transferred = output_dir / f"rawHGCROC_wPed_wBC_{muon_run}.root"
    muon_calibration = output_dir / f"rawHGCROC_wPedwMuon_wBC_{muon_run}.root"
    mip_selected = output_dir / f"rawHGCROC_mipTrigg_wPedwMuon_wBC_{muon_run}.root"
    refined_1 = output_dir / f"rawHGCROC_wPedwMuon_wBC_ImpR_{muon_run}.root"
    refined_2 = output_dir / f"rawHGCROC_wPedwMuon_wBC_Imp2R_{muon_run}.root"
    refined_3 = output_dir / f"rawHGCROC_wPedwMuon_wBC_Imp3R_{muon_run}.root"
    calibrated = output_dir / f"calibratedHGCROC_Run_{muon_run}.root"
    waveform = output_dir / f"calibratedHGCROC_wave_Run_{muon_run}.root"

    plot_dirs = {
        "pedestal": output_dir / f"PlotsPedestal/Run{pedestal_run}",
        "transfer": output_dir / f"HGCROC_PlotsCalibTransferWToA/Run_{muon_run}",
        "muon": output_dir / f"HGCROC_PlotsCalibMuon/Run_{muon_run}",
        "refine_1": output_dir / f"HGCROC_PlotsCalibMuonImproved_Red/Run_{muon_run}",
        "refine_2": output_dir / f"HGCROC_PlotsCalibMuonImproved2nd_Red/Run_{muon_run}",
        "refine_3": output_dir / f"HGCROC_PlotsCalibMuonImproved3rd_Red/Run_{muon_run}",
        "apply": output_dir / f"HGCROC_PlotsCalibrated/Run_{muon_run}",
        "waveform": output_dir / f"HGCROC_PlotsWave/Run_{muon_run}",
    }

    config_inputs = [("run_database", run_database)]
    lines = [
        "# Generated by tools/make-tb2026-paramscan-dag",
        f"# Pedestal run {pedestal_run}; muon run {muon_run}",
        "# The applied calibration follows the established TB2026 Set-1 Imp3R path.",
        "",
        job_line(
            "prepare",
            ["mkdir", "-p", output_dir, *plot_dirs.values()],
            outputs=[("workspace", output_dir)],
        ),
        job_line(
            f"convert-pedestal-{pedestal_run}",
            [convert, "-d", "0", "-f", "-w", "-c", raw_pedestal_h2g, "-o", raw_pedestal, "-m", mapping, "-r", run_database],
            inputs=[("raw_h2g", raw_pedestal_h2g), ("mapping", mapping), *config_inputs],
            outputs=[("raw_root", raw_pedestal)],
        ),
        job_line(
            f"convert-muon-{muon_run}",
            [convert, "-d", "0", "-f", "-w", "-c", raw_muon_h2g, "-o", raw_muon, "-m", mapping, "-r", run_database],
            inputs=[("raw_h2g", raw_muon_h2g), ("mapping", mapping), *config_inputs],
            outputs=[("raw_root", raw_muon)],
        ),
        job_line(
            f"pedestal-{pedestal_run}",
            [data_prep, "-a", "-d", "1", "-p", "-i", raw_pedestal, "-f", "-o", pedestal, "-O", plot_dirs["pedestal"], "-r", run_database, "-F", "pdf"],
            inputs=[("raw_pedestal", raw_pedestal), *config_inputs],
            outputs=[("pedestal", pedestal), ("plots", plot_dirs["pedestal"])],
        ),
        job_line(
            f"transfer-calibration-{muon_run}",
            [data_prep, "-d", "1", "-e", "-f", "-P", pedestal, "-i", raw_muon, "-o", transferred, "-O", plot_dirs["transfer"], "-r", run_database, "-B", bad_channels, "-G", toa_offsets],
            inputs=[("pedestal", pedestal), ("raw_muon", raw_muon), *config_inputs, ("bad_channels", bad_channels), ("toa_offsets", toa_offsets)],
            outputs=[("pedestal_transferred", transferred), ("plots", plot_dirs["transfer"])],
        ),
        job_line(
            f"muon-calibration-{muon_run}",
            [data_prep, "-a", "-f", "-d", "1", "-e", "-s", "-i", transferred, "-o", muon_calibration, "-O", plot_dirs["muon"], "-r", run_database],
            inputs=[("pedestal_transferred", transferred), *config_inputs],
            outputs=[("muon_calibration", muon_calibration), ("plots", plot_dirs["muon"])],
        ),
        job_line(
            f"select-mip-{muon_run}",
            [data_prep, "-f", "-d", "1", "-X", "-i", muon_calibration, "-o", mip_selected],
            inputs=[("muon_calibration", muon_calibration)],
            outputs=[("mip_selected", mip_selected)],
        ),
        job_line(
            f"refine-1-{muon_run}",
            [data_prep, "-a", "-f", "-d", "1", "-S", "-i", mip_selected, "-o", refined_1, "-O", plot_dirs["refine_1"], "-r", run_database],
            inputs=[("mip_selected", mip_selected), *config_inputs],
            outputs=[("refined_calibration", refined_1), ("plots", plot_dirs["refine_1"])],
        ),
        job_line(
            f"refine-2-{muon_run}",
            [data_prep, "-a", "-f", "-d", "1", "-S", "-i", refined_1, "-o", refined_2, "-O", plot_dirs["refine_2"], "-r", run_database],
            inputs=[("previous_calibration", refined_1), *config_inputs],
            outputs=[("refined_calibration", refined_2), ("plots", plot_dirs["refine_2"])],
        ),
        job_line(
            f"refine-3-{muon_run}",
            [data_prep, "-a", "-f", "-d", "1", "-S", "-i", refined_2, "-o", refined_3, "-O", plot_dirs["refine_3"], "-r", run_database],
            inputs=[("previous_calibration", refined_2), *config_inputs],
            outputs=[("refined_calibration", refined_3), ("plots", plot_dirs["refine_3"])],
        ),
        job_line(
            f"apply-calibration-{muon_run}",
            [data_prep, "-e", "-f", "-d", "1", "-a", "-C", refined_3, "-i", mip_selected, "-o", calibrated, "-O", plot_dirs["apply"], "-r", run_database, "-B", bad_channels, "-G", toa_offsets],
            inputs=[("final_calibration", refined_3), ("mip_selected", mip_selected), *config_inputs, ("bad_channels", bad_channels), ("toa_offsets", toa_offsets)],
            outputs=[("calibrated", calibrated), ("plots", plot_dirs["apply"])],
        ),
        job_line(
            f"waveform-{muon_run}",
            [hgcroc_study, "-d", "1", "-E", "1", "-f", "-w", "-i", calibrated, "-o", waveform, "-O", plot_dirs["waveform"], "-r", run_database, "-l", active_cells],
            inputs=[("calibrated", calibrated), *config_inputs, ("active_cells", active_cells)],
            outputs=[("waveform", waveform), ("plots", plot_dirs["waveform"])],
        ),
        "",
        f"PARENT prepare CHILD convert-pedestal-{pedestal_run} convert-muon-{muon_run}",
        f"PARENT convert-pedestal-{pedestal_run} CHILD pedestal-{pedestal_run}",
        f"PARENT pedestal-{pedestal_run} convert-muon-{muon_run} CHILD transfer-calibration-{muon_run}",
        f"PARENT transfer-calibration-{muon_run} CHILD muon-calibration-{muon_run}",
        f"PARENT muon-calibration-{muon_run} CHILD select-mip-{muon_run}",
        f"PARENT select-mip-{muon_run} CHILD refine-1-{muon_run}",
        f"PARENT refine-1-{muon_run} CHILD refine-2-{muon_run}",
        f"PARENT refine-2-{muon_run} CHILD refine-3-{muon_run}",
        f"PARENT refine-3-{muon_run} CHILD apply-calibration-{muon_run}",
        f"PARENT apply-calibration-{muon_run} CHILD waveform-{muon_run}",
        "",
    ]
    for name in (
        "prepare",
        f"convert-pedestal-{pedestal_run}",
        f"convert-muon-{muon_run}",
        f"pedestal-{pedestal_run}",
        f"transfer-calibration-{muon_run}",
        f"muon-calibration-{muon_run}",
        f"select-mip-{muon_run}",
        f"refine-1-{muon_run}",
        f"refine-2-{muon_run}",
        f"refine-3-{muon_run}",
        f"apply-calibration-{muon_run}",
        f"waveform-{muon_run}",
    ):
        lines.append(f"RETRY {name} 1")
    lines.append("")
    required = [convert, data_prep, hgcroc_study, mapping, run_database, bad_channels, toa_offsets, active_cells, raw_pedestal_h2g, raw_muon_h2g]
    return "\n".join(lines), required


def main(argv: Sequence[str] | None = None) -> int:
    args = parser().parse_args(argv)
    base = logical_cwd()
    manifest = absolute_path(args.manifest, base)
    if manifest.exists() and not args.force:
        print(f"make-tb2026-paramscan-dag: {manifest} already exists; use --force to replace it", file=sys.stderr)
        return 2
    content, required = generate(args)
    if args.check:
        missing = [path for path in required if not path.is_file()]
        if missing:
            print("make-tb2026-paramscan-dag: required files are missing:", file=sys.stderr)
            for path in missing:
                print(f"  {path}", file=sys.stderr)
            return 2
    manifest.parent.mkdir(parents=True, exist_ok=True)
    manifest.write_text(content, encoding="utf-8")
    print(f"Wrote {manifest}")
    print(f"Pedestal {args.pedestal_run} -> muon {args.muon_run}; 12 DAG jobs")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
