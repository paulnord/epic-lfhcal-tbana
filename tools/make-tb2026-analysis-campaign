#!/usr/bin/env python3
"""Generate convert, calibration, and waveform jobs for many TB2026 runs."""

from __future__ import annotations

import argparse
import pathlib
import sys
from collections.abc import Sequence

from lfhcal_campaign import (
    Campaign,
    absolute_path,
    logical_cwd,
    missing_files,
    parse_runs,
    write_manifest,
)


TOOL_NAME = "make-tb2026-analysis-campaign"


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(
        description=(
            "Generate independent Convert -> apply calibration -> waveform branches "
            "for TB2026 data runs. The output is an lfhcal-run campaign manifest; "
            "this command does not execute jobs."
        )
    )
    result.add_argument(
        "runs",
        nargs="+",
        metavar="RUN",
        help="run number or inclusive range, for example 137 138-149 153",
    )
    result.add_argument("--raw-dir", required=True, help="directory containing RunNNN.h2g")
    result.add_argument("--output-dir", required=True, help="new campaign product directory")
    result.add_argument(
        "--calibration",
        required=True,
        help="final ROOT calibration passed to DataPrep -C for every run",
    )
    result.add_argument("--manifest", required=True, help="campaign manifest to create")
    result.add_argument(
        "--repository",
        default=str(logical_cwd()),
        help="epic-lfhcal-tbana checkout (default: logical current directory)",
    )
    result.add_argument("--build-dir", help="directory containing Convert, DataPrep, HGCROCStudy")
    result.add_argument("--mapping", help="override the TB2026 V2 mapping")
    result.add_argument("--run-database", help="override the TB2026 run database")
    result.add_argument("--bad-channels", help="override the TB2026 bad-channel map")
    result.add_argument("--toa-offsets", help="override the TB2026 ToA offsets")
    result.add_argument("--active-cells", help="override the waveform active-cell list")
    result.add_argument("--retries", type=int, default=1, help="retries per job (default: 1)")
    result.add_argument(
        "--check",
        action="store_true",
        help="require executables, configuration, calibration, and raw inputs to exist",
    )
    result.add_argument("--force", action="store_true", help="replace an existing manifest")
    return result


def generate(args: argparse.Namespace) -> tuple[Campaign, list[pathlib.Path], list[int]]:
    base = logical_cwd()
    runs = parse_runs(args.runs)
    repository = absolute_path(args.repository, base)
    raw_dir = absolute_path(args.raw_dir, base)
    output_dir = absolute_path(args.output_dir, base)
    calibration = absolute_path(args.calibration, base)
    build_dir = absolute_path(args.build_dir, base) if args.build_dir else repository / "NewStructure/build"
    mapping = absolute_path(args.mapping, base) if args.mapping else repository / "configs/TB2026/mapping_HGCROC_SPSH2TB_sumV2_default.csv"
    run_database = absolute_path(args.run_database, base) if args.run_database else repository / "configs/TB2026/DataTakingDB_TBSPSH2_202605_HGCROC.csv"
    bad_channels = absolute_path(args.bad_channels, base) if args.bad_channels else repository / "configs/TB2026/badChannel_HGCROC_SPSTB2026_OnlyCenter2x4.txt"
    toa_offsets = absolute_path(args.toa_offsets, base) if args.toa_offsets else repository / "configs/TB2026/ToAOffsets_TBSPS2026_ParamScan_1.csv"
    active_cells = absolute_path(args.active_cells, base) if args.active_cells else repository / "configs/TB2026/activeCellsHGCROCParameterScan.txt"
    convert = build_dir / "Convert"
    data_prep = build_dir / "DataPrep"
    hgcroc_study = build_dir / "HGCROCStudy"

    plot_roots = {
        "calibration": output_dir / "HGCROC_PlotsCalibrated",
        "waveform": output_dir / "HGCROC_PlotsWave",
    }
    campaign = Campaign(
        [
            "Generated by tools/make-tb2026-analysis-campaign",
            f"TB2026 conversion, existing-calibration application, and waveform analysis for {len(runs)} run(s)",
            f"Shared final calibration: {calibration}",
        ]
    )
    campaign.add_job(
        "prepare",
        ["mkdir", "-p", output_dir, *plot_roots.values()],
        outputs=[("workspace", output_dir)],
        retries=args.retries,
    )

    raw_inputs: list[pathlib.Path] = []
    for run in runs:
        raw_h2g = raw_dir / f"Run{run}.h2g"
        raw_root = output_dir / f"rawHGCROC_{run}.root"
        calibrated = output_dir / f"calibratedHGCROC_Run_{run}.root"
        waveform = output_dir / f"calibratedHGCROC_wave_Run_{run}.root"
        calibration_plots = plot_roots["calibration"] / f"Run_{run}"
        waveform_plots = plot_roots["waveform"] / f"Run_{run}"
        raw_inputs.append(raw_h2g)

        convert_name = f"convert-{run}"
        apply_name = f"apply-calibration-{run}"
        campaign.add_job(
            convert_name,
            [
                convert,
                "-d",
                "0",
                "-f",
                "-w",
                "-c",
                raw_h2g,
                "-o",
                raw_root,
                "-m",
                mapping,
                "-r",
                run_database,
            ],
            inputs=[
                ("raw_h2g", raw_h2g),
                ("mapping", mapping),
                ("run_database", run_database),
            ],
            outputs=[("raw_root", raw_root)],
            parents=["prepare"],
            retries=args.retries,
        )
        campaign.add_job(
            apply_name,
            [
                data_prep,
                "-e",
                "-f",
                "-d",
                "1",
                "-a",
                "-C",
                calibration,
                "-i",
                raw_root,
                "-o",
                calibrated,
                "-O",
                calibration_plots,
                "-r",
                run_database,
                "-B",
                bad_channels,
                "-G",
                toa_offsets,
            ],
            inputs=[
                ("final_calibration", calibration),
                ("raw_root", raw_root),
                ("run_database", run_database),
                ("bad_channels", bad_channels),
                ("toa_offsets", toa_offsets),
            ],
            outputs=[("calibrated", calibrated), ("plots", calibration_plots)],
            parents=[convert_name],
            retries=args.retries,
        )
        campaign.add_job(
            f"waveform-{run}",
            [
                hgcroc_study,
                "-d",
                "1",
                "-E",
                "1",
                "-f",
                "-w",
                "-i",
                calibrated,
                "-o",
                waveform,
                "-O",
                waveform_plots,
                "-r",
                run_database,
                "-l",
                active_cells,
            ],
            inputs=[
                ("calibrated", calibrated),
                ("run_database", run_database),
                ("active_cells", active_cells),
            ],
            outputs=[("waveform", waveform), ("plots", waveform_plots)],
            parents=[apply_name],
            retries=args.retries,
        )

    required = [
        convert,
        data_prep,
        hgcroc_study,
        mapping,
        run_database,
        bad_channels,
        toa_offsets,
        active_cells,
        calibration,
        *raw_inputs,
    ]
    return campaign, required, runs


def main(argv: Sequence[str] | None = None) -> int:
    args = parser().parse_args(argv)
    if args.retries < 0:
        parser().error("--retries cannot be negative")
    try:
        campaign, required, runs = generate(args)
    except ValueError as error:
        parser().error(str(error))

    if args.check:
        missing = missing_files(required)
        if missing:
            print(f"{TOOL_NAME}: required files are missing:", file=sys.stderr)
            for path in missing:
                print(f"  {path}", file=sys.stderr)
            return 2

    manifest = absolute_path(args.manifest, logical_cwd())
    try:
        write_manifest(campaign, manifest, force=args.force, tool_name=TOOL_NAME)
    except FileExistsError as error:
        print(error, file=sys.stderr)
        return 2
    print(f"Wrote {manifest}")
    print(f"{len(runs)} run(s); {len(campaign.jobs)} campaign jobs")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
