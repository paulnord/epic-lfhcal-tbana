compare-cfcomp: comparison-lists
    @input list work/comparison/cfcomp.txt
    @input rundb ../../../configs/TB2026/DataTakingDB_TBSPSH2_202605_HGCROC.csv
    @input cells ../../../configs/TB2026/activeCellsHGCROCParameterScan.txt
