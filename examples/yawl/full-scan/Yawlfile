campaign lfhcal-tb2026-full-scan
backend condor

# Site-specific raw HGCROC data directory. Resolved and frozen by yawl-run.
@env LFHCAL_RAW

@set BUILD ../../../NewStructure/build
@set CONFIG ../../../configs/TB2026

%cpus 1
%memory 4GB
%disk 8GB
%getenv true
%wrapper ../../../tools/run-in-eic-container.sh

# Curated 44-file parameter-scan study: 22 pedestal/muon pairs.
#
# Selection rationale:
#   - 296/298 is the nominal RF9 CF7 CC5 CFComp1 reference.
#   - 301/302 is excluded: run 302 is the known bad/short data file.
#   - 307/308 is used for RF4 instead of duplicate-setting 305/306.
#   - 354/355 is used for RF9 CF5 CC5 CFComp1 instead of duplicate 362/363.
#   - later special pairs 364/366 and 367/369 are outside this 44-file study.
#
# The explicit run list is intentionally frozen here rather than discovered from
# whatever Run*.h2g files happen to be visible in LFHCAL_RAW.

prepare:
    /bin/mkdir -p work/converted work/pedestal work/transfer work/mip \
        work/selected work/refine1 work/refine2 work/refine3 \
        work/calibrated work/waveform work/comparison \
        work/plots/pedestal work/plots/transfer work/plots/mip \
        work/plots/refine1 work/plots/refine2 work/plots/refine3 \
        work/plots/calibrated work/plots/waveform work/plots/comparison

convert-{run}: prepare
    @each run \
        296 298 299 300 303 304 307 308 309 310 \
        328 329 330 331 332 333 334 335 336 337 338 339 \
        340 341 342 343 344 345 346 347 348 349 350 351 \
        352 353 354 355 356 357 358 359 360 361
    @input raw {LFHCAL_RAW}/Run{run}.h2g
    @input mapping {CONFIG}/mapping_HGCROC_SPSH2TB_sumV2_default.csv
    @input rundb {CONFIG}/DataTakingDB_TBSPSH2_202605_HGCROC.csv
    @output root work/converted/rawHGCROC_{run}.root
    %memory 2GB
    {BUILD}/Convert -d 0 -w -c @input.raw \
        -o @output.root -m @input.mapping -r @input.rundb

# Barrier keeps the campaign easy to inspect: finish all raw conversions before
# launching calibration chains.
converted: convert-{run}
    /usr/bin/true

pedestal-{ped}-{run}-{toa}: converted
    @each ped run toa: \
        296 298 1 \
        299 300 1 \
        303 304 1 \
        307 308 1 \
        309 310 1 \
        328 329 2 \
        330 331 2 \
        332 333 2 \
        334 335 2 \
        336 337 2 \
        338 339 2 \
        340 341 2 \
        342 343 2 \
        344 345 2 \
        346 347 2 \
        348 349 2 \
        350 351 2 \
        352 353 2 \
        354 355 2 \
        356 357 2 \
        358 359 2 \
        360 361 2
    @input raw work/converted/rawHGCROC_{ped}.root
    @input rundb {CONFIG}/DataTakingDB_TBSPSH2_202605_HGCROC.csv
    @output root work/pedestal/rawHGCROC_wPed_{ped}.root
    @output calib work/pedestal/rawHGCROC_wPed_{ped}_calib.txt
    @output hists work/pedestal/rawHGCROC_wPed_{ped}_Hists.root
    @output plots work/plots/pedestal/Run{ped}
    {BUILD}/DataPrep -a -d 1 -p -i @input.raw \
        -o @output.root -O @output.plots -r @input.rundb -F pdf

transfer-{ped}-{run}-{toa}: pedestal-{ped}-{run}-{toa}
    @input pedestal work/pedestal/rawHGCROC_wPed_{ped}.root
    @input raw work/converted/rawHGCROC_{run}.root
    @input bad {CONFIG}/badChannel_HGCROC_SPSTB2026_OnlyCenter2x4.txt
    @input toa {CONFIG}/ToAOffsets_TBSPS2026_ParamScan_{toa}.csv
    @input rundb {CONFIG}/DataTakingDB_TBSPSH2_202605_HGCROC.csv
    @output root work/transfer/rawHGCROC_wPed_wBC_{run}.root
    @output plots work/plots/transfer/Run{run}
    {BUILD}/DataPrep -d 1 -e -P @input.pedestal \
        -i @input.raw -o @output.root -O @output.plots \
        -r @input.rundb -B @input.bad -G @input.toa

mip-{ped}-{run}-{toa}: transfer-{ped}-{run}-{toa}
    @input root work/transfer/rawHGCROC_wPed_wBC_{run}.root
    @input rundb {CONFIG}/DataTakingDB_TBSPSH2_202605_HGCROC.csv
    @output root work/mip/rawHGCROC_wPedwMuon_wBC_{run}.root
    @output calib work/mip/rawHGCROC_wPedwMuon_wBC_{run}_calib.txt
    @output hists work/mip/rawHGCROC_wPedwMuon_wBC_{run}_Hists.root
    @output plots work/plots/mip/Run{run}
    {BUILD}/DataPrep -a -d 1 -e -s -i @input.root \
        -o @output.root -O @output.plots -r @input.rundb

select-{ped}-{run}-{toa}: mip-{ped}-{run}-{toa}
    @input root work/mip/rawHGCROC_wPedwMuon_wBC_{run}.root
    @output root work/selected/rawHGCROC_mipTrigg_wPedwMuon_wBC_{run}.root
    {BUILD}/DataPrep -d 1 -X -i @input.root -o @output.root

refine1-{ped}-{run}-{toa}: select-{ped}-{run}-{toa}
    @input root work/selected/rawHGCROC_mipTrigg_wPedwMuon_wBC_{run}.root
    @input rundb {CONFIG}/DataTakingDB_TBSPSH2_202605_HGCROC.csv
    @output root work/refine1/rawHGCROC_wPedwMuon_wBC_ImpR_{run}.root
    @output calib work/refine1/rawHGCROC_wPedwMuon_wBC_ImpR_{run}_calib.txt
    @output hists work/refine1/rawHGCROC_wPedwMuon_wBC_ImpR_{run}_Hists.root
    @output plots work/plots/refine1/Run{run}
    {BUILD}/DataPrep -a -d 1 -S -i @input.root \
        -o @output.root -O @output.plots -r @input.rundb

refine2-{ped}-{run}-{toa}: refine1-{ped}-{run}-{toa}
    @input root work/refine1/rawHGCROC_wPedwMuon_wBC_ImpR_{run}.root
    @input rundb {CONFIG}/DataTakingDB_TBSPSH2_202605_HGCROC.csv
    @output root work/refine2/rawHGCROC_wPedwMuon_wBC_Imp2R_{run}.root
    @output calib work/refine2/rawHGCROC_wPedwMuon_wBC_Imp2R_{run}_calib.txt
    @output hists work/refine2/rawHGCROC_wPedwMuon_wBC_Imp2R_{run}_Hists.root
    @output plots work/plots/refine2/Run{run}
    {BUILD}/DataPrep -a -d 1 -S -i @input.root \
        -o @output.root -O @output.plots -r @input.rundb

refine3-{ped}-{run}-{toa}: refine2-{ped}-{run}-{toa}
    @input root work/refine2/rawHGCROC_wPedwMuon_wBC_Imp2R_{run}.root
    @input rundb {CONFIG}/DataTakingDB_TBSPSH2_202605_HGCROC.csv
    @output root work/refine3/rawHGCROC_wPedwMuon_wBC_Imp3R_{run}.root
    @output calib work/refine3/rawHGCROC_wPedwMuon_wBC_Imp3R_{run}_calib.txt
    @output hists work/refine3/rawHGCROC_wPedwMuon_wBC_Imp3R_{run}_Hists.root
    @output plots work/plots/refine3/Run{run}
    {BUILD}/DataPrep -a -d 1 -S -i @input.root \
        -o @output.root -O @output.plots -r @input.rundb

calibrate-{ped}-{run}-{toa}: refine3-{ped}-{run}-{toa}
    @input calibration work/refine3/rawHGCROC_wPedwMuon_wBC_Imp3R_{run}.root
    @input raw work/selected/rawHGCROC_mipTrigg_wPedwMuon_wBC_{run}.root
    @input bad {CONFIG}/badChannel_HGCROC_SPSTB2026_OnlyCenter2x4.txt
    @input toa {CONFIG}/ToAOffsets_TBSPS2026_ParamScan_{toa}.csv
    @input rundb {CONFIG}/DataTakingDB_TBSPSH2_202605_HGCROC.csv
    @output root work/calibrated/calibratedHGCROC_Run_{run}.root
    @output plots work/plots/calibrated/Run{run}
    {BUILD}/DataPrep -e -d 1 -a -C @input.calibration \
        -i @input.raw -o @output.root -O @output.plots -r @input.rundb \
        -B @input.bad -G @input.toa

waveform-{ped}-{run}-{toa}: calibrate-{ped}-{run}-{toa}
    @input root work/calibrated/calibratedHGCROC_Run_{run}.root
    @input cells {CONFIG}/activeCellsHGCROCParameterScan.txt
    @input rundb {CONFIG}/DataTakingDB_TBSPSH2_202605_HGCROC.csv
    @output root work/waveform/calibratedHGCROC_wave_Run_{run}.root
    @output hists work/waveform/calibratedHGCROC_wave_Run_{run}_Hists.root
    @output plots work/plots/waveform/Run{run}
    {BUILD}/HGCROCStudy -d 1 -E 1 -w -i @input.root \
        -o @output.root -O @output.plots -r @input.rundb -l @input.cells

# CompareWaveform still consumes a two-column text file.  Generate those five
# interface files directly here so the comparison membership remains part of
# the frozen Yawlfile rather than being recomputed by a separate script.
comparison-lists: waveform-{ped}-{run}-{toa}
    @input calib work/calibrated/calibratedHGCROC_Run_{run}.root
    @input hist work/waveform/calibratedHGCROC_wave_Run_{run}_Hists.root
    @output all work/comparison/all.txt
    @output rf work/comparison/rf.txt
    @output cf work/comparison/cf.txt
    @output cfcomp work/comparison/cfcomp.txt
    @output cc work/comparison/cc.txt
    ! for run in 298 300 304 308 310 329 331 333 335 337 339 341 343 345 347 349 351 353 355 357 359 361; do \
        printf 'work/calibrated/calibratedHGCROC_Run_%s.root work/waveform/calibratedHGCROC_wave_Run_%s_Hists.root\n' "$run" "$run"; \
      done > @output.all; \
      for run in 298 300 304 308 310 329 331 333 335 337 339 341 343 345; do \
        printf 'work/calibrated/calibratedHGCROC_Run_%s.root work/waveform/calibratedHGCROC_wave_Run_%s_Hists.root\n' "$run" "$run"; \
      done > @output.rf; \
      for run in 298 355 361; do \
        printf 'work/calibrated/calibratedHGCROC_Run_%s.root work/waveform/calibratedHGCROC_wave_Run_%s_Hists.root\n' "$run" "$run"; \
      done > @output.cf; \
      for run in 355 357 359; do \
        printf 'work/calibrated/calibratedHGCROC_Run_%s.root work/waveform/calibratedHGCROC_wave_Run_%s_Hists.root\n' "$run" "$run"; \
      done > @output.cfcomp; \
      for run in 298 347 349 351 353; do \
        printf 'work/calibrated/calibratedHGCROC_Run_%s.root work/waveform/calibratedHGCROC_wave_Run_%s_Hists.root\n' "$run" "$run"; \
      done > @output.cc

compare-all: comparison-lists
    @input list work/comparison/all.txt
    @input rundb {CONFIG}/DataTakingDB_TBSPSH2_202605_HGCROC.csv
    @input cells {CONFIG}/activeCellsHGCROCParameterScan.txt
    @output root work/comparison/compWaveAll.root
    @output plots work/plots/comparison/all
    %memory 8GB
    {BUILD}/CompareWaveform -d 1 -e 1 -E 1 \
        -I @input.list -o @output.root -O @output.plots \
        -r @input.rundb -c @input.cells

