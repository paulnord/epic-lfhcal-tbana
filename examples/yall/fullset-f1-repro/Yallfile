campaign lfhcal-tb2026-fullset-f1-repro
backend condor

# Reproduce Fredi's SPS H2 FullSetF_1 calibration chain from raw data.
# Source recipe:
#   NewStructure/convertDataHGCROC_TBSPSH2_2026.sh
#   NewStructure/runHGCROCCalibration_TBSPSH2_2026.sh
#   NewStructure/helperCalibHGCROC.sh
#   NewStructure/stripCalib_TBSPSH2_2026.sh
#
# FullSetF_1 uses muon runs 426-430 merged as Muon_FullSetF_1,
# pedestal run 431, the FullSetA-F bad-channel map, the FullSetF ToA
# offsets, and five reduced/no-event-tree improvement passes through Imp5R.
#
# Fredi's published reference calibration is:
#   ../../../calibrations/TB2026/calib_SPS-H2_FullSetF_1.txt
#
# fixSetup is intentionally omitted: it repairs already-converted files after
# mapping changes. This workflow converts fresh from raw using the current map.

@env LFHCAL_DATA
@env LFHCAL_WORK
@env EIC_SHELL
@set BUILD ../../../NewStructure/build
@set TB2026_CONFIG ../../../configs/TB2026

%cpus 1
%memory 4GB
%disk 8GB
%time 2h
%getenv true
%wrapper ../../../tools/run-in-eic-shell.sh {EIC_SHELL} /usr/bin/env ROOT_MAX_THREADS=1 OMP_NUM_THREADS=1

prepare:
    /bin/mkdir -p \
        {LFHCAL_WORK}/fullset-f1-repro/converted \
        {LFHCAL_WORK}/fullset-f1-repro/pedestal \
        {LFHCAL_WORK}/fullset-f1-repro/transfer \
        {LFHCAL_WORK}/fullset-f1-repro/mip \
        {LFHCAL_WORK}/fullset-f1-repro/selected \
        {LFHCAL_WORK}/fullset-f1-repro/refine1 \
        {LFHCAL_WORK}/fullset-f1-repro/refine2 \
        {LFHCAL_WORK}/fullset-f1-repro/refine3 \
        {LFHCAL_WORK}/fullset-f1-repro/refine4 \
        {LFHCAL_WORK}/fullset-f1-repro/refine5 \
        {LFHCAL_WORK}/fullset-f1-repro/final \
        {LFHCAL_WORK}/fullset-f1-repro/plots/pedestal \
        {LFHCAL_WORK}/fullset-f1-repro/plots/transfer \
        {LFHCAL_WORK}/fullset-f1-repro/plots/mip \
        {LFHCAL_WORK}/fullset-f1-repro/plots/refine1 \
        {LFHCAL_WORK}/fullset-f1-repro/plots/refine2 \
        {LFHCAL_WORK}/fullset-f1-repro/plots/refine3 \
        {LFHCAL_WORK}/fullset-f1-repro/plots/refine4 \
        {LFHCAL_WORK}/fullset-f1-repro/plots/refine5

convert-{run}: prepare
    @each run 426 427 428 429 430 431
    @input raw {LFHCAL_DATA}/Run{run}.h2g
    @input mapping {TB2026_CONFIG}/mapping_HGCROC_SPSH2TB_sumV2_default.csv
    @input rundb {TB2026_CONFIG}/DataTakingDB_TBSPSH2_202605_HGCROC.csv
    @output root {LFHCAL_WORK}/fullset-f1-repro/converted/rawHGCROC_{run}.root
    %memory 2GB
    {BUILD}/Convert -d 0 -f -w -c @input.raw \
        -o @output.root -m @input.mapping -r @input.rundb

merge-muons: convert-426 convert-427 convert-428 convert-429 convert-430
    @input r426 {LFHCAL_WORK}/fullset-f1-repro/converted/rawHGCROC_426.root
    @input r427 {LFHCAL_WORK}/fullset-f1-repro/converted/rawHGCROC_427.root
    @input r428 {LFHCAL_WORK}/fullset-f1-repro/converted/rawHGCROC_428.root
    @input r429 {LFHCAL_WORK}/fullset-f1-repro/converted/rawHGCROC_429.root
    @input r430 {LFHCAL_WORK}/fullset-f1-repro/converted/rawHGCROC_430.root
    @output root {LFHCAL_WORK}/fullset-f1-repro/converted/rawHGCROC_Muon_FullSetF_1.root
    hadd -f @output.root \
        @input.r426 @input.r427 @input.r428 @input.r429 @input.r430

pedestal-431: convert-431
    @input raw {LFHCAL_WORK}/fullset-f1-repro/converted/rawHGCROC_431.root
    @input rundb {TB2026_CONFIG}/DataTakingDB_TBSPSH2_202605_HGCROC.csv
    @output root {LFHCAL_WORK}/fullset-f1-repro/pedestal/rawHGCROC_wPed_431.root
    @output calib {LFHCAL_WORK}/fullset-f1-repro/pedestal/rawHGCROC_wPed_431_calib.txt
    @output hists {LFHCAL_WORK}/fullset-f1-repro/pedestal/rawHGCROC_wPed_431_Hists.root
    @output plots {LFHCAL_WORK}/fullset-f1-repro/plots/pedestal/Run431
    {BUILD}/DataPrep -a -d 1 -p -i @input.raw -f \
        -o @output.root -O @output.plots -r @input.rundb -F pdf

transfer-f1: merge-muons pedestal-431
    @input pedestal {LFHCAL_WORK}/fullset-f1-repro/pedestal/rawHGCROC_wPed_431.root
    @input raw {LFHCAL_WORK}/fullset-f1-repro/converted/rawHGCROC_Muon_FullSetF_1.root
    @input bad {TB2026_CONFIG}/badChannel_HGCROC_SPSTB2026_FullSetA-F.txt
    @input toa {TB2026_CONFIG}/ToAOffsets_TBSPS2026_FullSetF.csv
    @input rundb {TB2026_CONFIG}/DataTakingDB_TBSPSH2_202605_HGCROC.csv
    @output root {LFHCAL_WORK}/fullset-f1-repro/transfer/rawHGCROC_wPed_wBC_Muon_FullSetF_1.root
    @output plots {LFHCAL_WORK}/fullset-f1-repro/plots/transfer/Muon_FullSetF_1
    {BUILD}/DataPrep -d 1 -e -f -P @input.pedestal \
        -i @input.raw -o @output.root -O @output.plots \
        -r @input.rundb -B @input.bad -G @input.toa

mip-f1: transfer-f1
    @input root {LFHCAL_WORK}/fullset-f1-repro/transfer/rawHGCROC_wPed_wBC_Muon_FullSetF_1.root
    @input rundb {TB2026_CONFIG}/DataTakingDB_TBSPSH2_202605_HGCROC.csv
    @output root {LFHCAL_WORK}/fullset-f1-repro/mip/rawHGCROC_wPedwMuon_wBC_Muon_FullSetF_1.root
    @output calib {LFHCAL_WORK}/fullset-f1-repro/mip/rawHGCROC_wPedwMuon_wBC_Muon_FullSetF_1_calib.txt
    @output hists {LFHCAL_WORK}/fullset-f1-repro/mip/rawHGCROC_wPedwMuon_wBC_Muon_FullSetF_1_Hists.root
    @output plots {LFHCAL_WORK}/fullset-f1-repro/plots/mip/Muon_FullSetF_1
    {BUILD}/DataPrep -a -f -d 1 -e -s -i @input.root \
        -o @output.root -O @output.plots -r @input.rundb

select-f1: mip-f1
    @input root {LFHCAL_WORK}/fullset-f1-repro/mip/rawHGCROC_wPedwMuon_wBC_Muon_FullSetF_1.root
    @output root {LFHCAL_WORK}/fullset-f1-repro/selected/rawHGCROC_mipTrigg_wPedwMuon_wBC_Muon_FullSetF_1.root
    {BUILD}/DataPrep -f -d 1 -X -i @input.root -o @output.root

# Fredi's *_red_woE recipe keeps fitting the same skimmed MIP sample and feeds
# the previous pass's text calibration back with -k. It does not feed the
# previous ROOT output into the next pass.
refine1-f1: select-f1
    @input root {LFHCAL_WORK}/fullset-f1-repro/selected/rawHGCROC_mipTrigg_wPedwMuon_wBC_Muon_FullSetF_1.root
    @input rundb {TB2026_CONFIG}/DataTakingDB_TBSPSH2_202605_HGCROC.csv
    @output root {LFHCAL_WORK}/fullset-f1-repro/refine1/rawHGCROC_wPedwMuon_wBC_ImpR_Muon_FullSetF_1.root
    @output calib {LFHCAL_WORK}/fullset-f1-repro/refine1/rawHGCROC_wPedwMuon_wBC_ImpR_Muon_FullSetF_1_calib.txt
    @output plots {LFHCAL_WORK}/fullset-f1-repro/plots/refine1/Muon_FullSetF_1
    {BUILD}/DataPrep -x -a -f -d 1 -S -i @input.root \
        -o @output.root -O @output.plots -r @input.rundb

refine2-f1: refine1-f1
    @input root {LFHCAL_WORK}/fullset-f1-repro/selected/rawHGCROC_mipTrigg_wPedwMuon_wBC_Muon_FullSetF_1.root
    @input prev {LFHCAL_WORK}/fullset-f1-repro/refine1/rawHGCROC_wPedwMuon_wBC_ImpR_Muon_FullSetF_1_calib.txt
    @input rundb {TB2026_CONFIG}/DataTakingDB_TBSPSH2_202605_HGCROC.csv
    @output root {LFHCAL_WORK}/fullset-f1-repro/refine2/rawHGCROC_wPedwMuon_wBC_Imp2R_Muon_FullSetF_1.root
    @output calib {LFHCAL_WORK}/fullset-f1-repro/refine2/rawHGCROC_wPedwMuon_wBC_Imp2R_Muon_FullSetF_1_calib.txt
    @output plots {LFHCAL_WORK}/fullset-f1-repro/plots/refine2/Muon_FullSetF_1
    {BUILD}/DataPrep -x -a -f -d 1 -S -i @input.root -k @input.prev \
        -o @output.root -O @output.plots -r @input.rundb

refine3-f1: refine2-f1
    @input root {LFHCAL_WORK}/fullset-f1-repro/selected/rawHGCROC_mipTrigg_wPedwMuon_wBC_Muon_FullSetF_1.root
    @input prev {LFHCAL_WORK}/fullset-f1-repro/refine2/rawHGCROC_wPedwMuon_wBC_Imp2R_Muon_FullSetF_1_calib.txt
    @input rundb {TB2026_CONFIG}/DataTakingDB_TBSPSH2_202605_HGCROC.csv
    @output root {LFHCAL_WORK}/fullset-f1-repro/refine3/rawHGCROC_wPedwMuon_wBC_Imp3R_Muon_FullSetF_1.root
    @output calib {LFHCAL_WORK}/fullset-f1-repro/refine3/rawHGCROC_wPedwMuon_wBC_Imp3R_Muon_FullSetF_1_calib.txt
    @output plots {LFHCAL_WORK}/fullset-f1-repro/plots/refine3/Muon_FullSetF_1
    {BUILD}/DataPrep -x -a -f -d 1 -S -i @input.root -k @input.prev \
        -o @output.root -O @output.plots -r @input.rundb

refine4-f1: refine3-f1
    @input root {LFHCAL_WORK}/fullset-f1-repro/selected/rawHGCROC_mipTrigg_wPedwMuon_wBC_Muon_FullSetF_1.root
    @input prev {LFHCAL_WORK}/fullset-f1-repro/refine3/rawHGCROC_wPedwMuon_wBC_Imp3R_Muon_FullSetF_1_calib.txt
    @input rundb {TB2026_CONFIG}/DataTakingDB_TBSPSH2_202605_HGCROC.csv
    @output root {LFHCAL_WORK}/fullset-f1-repro/refine4/rawHGCROC_wPedwMuon_wBC_Imp4R_Muon_FullSetF_1.root
    @output calib {LFHCAL_WORK}/fullset-f1-repro/refine4/rawHGCROC_wPedwMuon_wBC_Imp4R_Muon_FullSetF_1_calib.txt
    @output plots {LFHCAL_WORK}/fullset-f1-repro/plots/refine4/Muon_FullSetF_1
    {BUILD}/DataPrep -x -a -f -d 1 -S -i @input.root -k @input.prev \
        -o @output.root -O @output.plots -r @input.rundb

refine5-f1: refine4-f1
    @input root {LFHCAL_WORK}/fullset-f1-repro/selected/rawHGCROC_mipTrigg_wPedwMuon_wBC_Muon_FullSetF_1.root
    @input prev {LFHCAL_WORK}/fullset-f1-repro/refine4/rawHGCROC_wPedwMuon_wBC_Imp4R_Muon_FullSetF_1_calib.txt
    @input rundb {TB2026_CONFIG}/DataTakingDB_TBSPSH2_202605_HGCROC.csv
    @output root {LFHCAL_WORK}/fullset-f1-repro/refine5/rawHGCROC_wPedwMuon_wBC_Imp5R_Muon_FullSetF_1.root
    @output calib {LFHCAL_WORK}/fullset-f1-repro/refine5/rawHGCROC_wPedwMuon_wBC_Imp5R_Muon_FullSetF_1_calib.txt
    @output plots {LFHCAL_WORK}/fullset-f1-repro/plots/refine5/Muon_FullSetF_1
    {BUILD}/DataPrep -x -a -f -d 1 -S -i @input.root -k @input.prev \
        -o @output.root -O @output.plots -r @input.rundb

final-f1: refine5-f1
    @input root {LFHCAL_WORK}/fullset-f1-repro/refine5/rawHGCROC_wPedwMuon_wBC_Imp5R_Muon_FullSetF_1.root
    @input calib {LFHCAL_WORK}/fullset-f1-repro/refine5/rawHGCROC_wPedwMuon_wBC_Imp5R_Muon_FullSetF_1_calib.txt
    @output root {LFHCAL_WORK}/fullset-f1-repro/final/calib_Final_Muon_FullSetF_1.root
    @output calib {LFHCAL_WORK}/fullset-f1-repro/final/calib_Final_Muon_FullSetF_1_calib.txt
    /bin/cp @input.root @output.root && /bin/cp @input.calib @output.calib
