campaign lfhcal-tb2026-fullset-g2-repro
backend condor

# Reproduce Fredi's SPS H2 FullSetG_2 calibration chain from raw data.
# Source recipe:
#   NewStructure/convertDataHGCROC_TBSPSH2_2026.sh
#   NewStructure/runHGCROCCalibration_TBSPSH2_2026.sh
#   NewStructure/helperCalibHGCROC.sh
#   NewStructure/stripCalib_TBSPSH2_2026.sh
#
# FullSetG_2 uses pedestal run 529 and muon runs
# 530, 531, 532, 533, 534, 535, 536, and 537 merged as Muon_FullSetG_2.
#
# Unlike FullSet F, Set G uses the V1 summing-board mapping together with the
# FullSetG bad-channel map and FullSetG ToA offsets.
#
# Fredi's published reference calibration is:
#   ../../../calibrations/TB2026/calib_SPS-H2_FullSetG_2.txt
#
# The ToA offsets are consumed from the published FullSetG file. This workflow
# does not rederive them from hadron run 498.
#
# fixSetup is intentionally omitted: it repairs already-converted files after
# mapping changes. This workflow converts fresh from raw using the current map.

@env LFHCAL_DATA
@env LFHCAL_WORK
@env EIC_SHELL

@set BUILD ../../../NewStructure/build
@set TB2026_CONFIG ../../../configs/TB2026
@set WORK fullset-g2-repro
@set SET FullSetG_2
@set MAPPING ../../../configs/TB2026/mapping_HGCROC_SPSH2TB_sumV1_default.csv
@set BAD_CHANNELS ../../../configs/TB2026/badChannel_HGCROC_SPSTB2026_FullSetG.txt
@set TOA ../../../configs/TB2026/ToAOffsets_TBSPS2026_FullSetG.csv
@set RUNDB ../../../configs/TB2026/DataTakingDB_TBSPSH2_202605_HGCROC.csv

# Scientific run configuration lives here.
@table runs type run:
    pedestal 529
    muon     530
    muon     531
    muon     532
    muon     533
    muon     534
    muon     535
    muon     536
    muon     537

%cpus 1
%memory 4GB
%disk 8GB
%time 2h
%getenv true
%wrapper ../../../tools/run-in-eic-shell.sh {EIC_SHELL} /usr/bin/env ROOT_MAX_THREADS=1 OMP_NUM_THREADS=1

prepare:
    /bin/mkdir -p \
        {LFHCAL_WORK}/{WORK}/converted \
        {LFHCAL_WORK}/{WORK}/pedestal \
        {LFHCAL_WORK}/{WORK}/transfer \
        {LFHCAL_WORK}/{WORK}/mip \
        {LFHCAL_WORK}/{WORK}/selected \
        {LFHCAL_WORK}/{WORK}/refine1 \
        {LFHCAL_WORK}/{WORK}/refine2 \
        {LFHCAL_WORK}/{WORK}/refine3 \
        {LFHCAL_WORK}/{WORK}/refine4 \
        {LFHCAL_WORK}/{WORK}/refine5 \
        {LFHCAL_WORK}/{WORK}/final \
        {LFHCAL_WORK}/{WORK}/plots/pedestal \
        {LFHCAL_WORK}/{WORK}/plots/transfer \
        {LFHCAL_WORK}/{WORK}/plots/mip \
        {LFHCAL_WORK}/{WORK}/plots/refine1 \
        {LFHCAL_WORK}/{WORK}/plots/refine2 \
        {LFHCAL_WORK}/{WORK}/plots/refine3 \
        {LFHCAL_WORK}/{WORK}/plots/refine4 \
        {LFHCAL_WORK}/{WORK}/plots/refine5

# Convert every raw run through one task family.
convert-{type}-{run}: prepare
    @each type run in runs
    @input raw {LFHCAL_DATA}/Run{run}.h2g
    @input mapping {MAPPING}
    @input rundb {RUNDB}
    @output root {LFHCAL_WORK}/{WORK}/converted/rawHGCROC_{run}.root
    %memory 2GB
    {BUILD}/Convert -d 0 -f -w -c @input.raw \
        -o @output.root -m @input.mapping -r @input.rundb

# Binding type=muon restricts the patterned parent fan-in, and therefore
# @input.parts, to the eight muon conversions.
merge-{type}: convert-{type}-{run}
    @each type muon
    @input parts {LFHCAL_WORK}/{WORK}/converted/rawHGCROC_{run}.root
    @output root {LFHCAL_WORK}/{WORK}/converted/rawHGCROC_Muon_{SET}.root
    hadd -f @output.root @input.parts

# Bind type here; run is inherited from the compatible conversion row.
{type}-{run}: convert-{type}-{run}
    @each type pedestal
    @input raw {LFHCAL_WORK}/{WORK}/converted/rawHGCROC_{run}.root
    @input rundb {RUNDB}
    @output root {LFHCAL_WORK}/{WORK}/pedestal/rawHGCROC_wPed.root
    @output calib {LFHCAL_WORK}/{WORK}/pedestal/rawHGCROC_wPed_calib.txt
    @output hists {LFHCAL_WORK}/{WORK}/pedestal/rawHGCROC_wPed_Hists.root
    @output plots {LFHCAL_WORK}/{WORK}/plots/pedestal/Run{run}
    {BUILD}/DataPrep -a -d 1 -p -i @input.raw -f \
        -o @output.root -O @output.plots -r @input.rundb -F pdf

# The patterned pedestal parent keeps this dependency tied to the run table.
transfer-g2: merge-muon {type}-{run}
    @input pedestal {LFHCAL_WORK}/{WORK}/pedestal/rawHGCROC_wPed.root
    @input raw {LFHCAL_WORK}/{WORK}/converted/rawHGCROC_Muon_{SET}.root
    @input bad {BAD_CHANNELS}
    @input toa {TOA}
    @input rundb {RUNDB}
    @output root {LFHCAL_WORK}/{WORK}/transfer/rawHGCROC_wPed_wBC_Muon_{SET}.root
    @output plots {LFHCAL_WORK}/{WORK}/plots/transfer/Muon_{SET}
    {BUILD}/DataPrep -d 1 -e -f -P @input.pedestal \
        -i @input.raw -o @output.root -O @output.plots \
        -r @input.rundb -B @input.bad -G @input.toa

mip-g2: transfer-g2
    @input root {LFHCAL_WORK}/{WORK}/transfer/rawHGCROC_wPed_wBC_Muon_{SET}.root
    @input rundb {RUNDB}
    @output root {LFHCAL_WORK}/{WORK}/mip/rawHGCROC_wPedwMuon_wBC_Muon_{SET}.root
    @output calib {LFHCAL_WORK}/{WORK}/mip/rawHGCROC_wPedwMuon_wBC_Muon_{SET}_calib.txt
    @output hists {LFHCAL_WORK}/{WORK}/mip/rawHGCROC_wPedwMuon_wBC_Muon_{SET}_Hists.root
    @output plots {LFHCAL_WORK}/{WORK}/plots/mip/Muon_{SET}
    {BUILD}/DataPrep -a -f -d 1 -e -s -i @input.root \
        -o @output.root -O @output.plots -r @input.rundb

select-g2: mip-g2
    @input root {LFHCAL_WORK}/{WORK}/mip/rawHGCROC_wPedwMuon_wBC_Muon_{SET}.root
    @output root {LFHCAL_WORK}/{WORK}/selected/rawHGCROC_mipTrigg_wPedwMuon_wBC_Muon_{SET}.root
    {BUILD}/DataPrep -f -d 1 -X -i @input.root -o @output.root

# Fredi's *_red_woE recipe keeps fitting the same skimmed MIP sample and feeds
# the previous pass's text calibration back with -k. It does not feed the
# previous ROOT output into the next pass.
refine1-g2: select-g2
    @input root {LFHCAL_WORK}/{WORK}/selected/rawHGCROC_mipTrigg_wPedwMuon_wBC_Muon_{SET}.root
    @input rundb {RUNDB}
    @output root {LFHCAL_WORK}/{WORK}/refine1/rawHGCROC_wPedwMuon_wBC_ImpR_Muon_{SET}.root
    @output calib {LFHCAL_WORK}/{WORK}/refine1/rawHGCROC_wPedwMuon_wBC_ImpR_Muon_{SET}_calib.txt
    @output plots {LFHCAL_WORK}/{WORK}/plots/refine1/Muon_{SET}
    {BUILD}/DataPrep -x -a -f -d 1 -S -i @input.root \
        -o @output.root -O @output.plots -r @input.rundb

refine2-g2: refine1-g2
    @input root {LFHCAL_WORK}/{WORK}/selected/rawHGCROC_mipTrigg_wPedwMuon_wBC_Muon_{SET}.root
    @input prev {LFHCAL_WORK}/{WORK}/refine1/rawHGCROC_wPedwMuon_wBC_ImpR_Muon_{SET}_calib.txt
    @input rundb {RUNDB}
    @output root {LFHCAL_WORK}/{WORK}/refine2/rawHGCROC_wPedwMuon_wBC_Imp2R_Muon_{SET}.root
    @output calib {LFHCAL_WORK}/{WORK}/refine2/rawHGCROC_wPedwMuon_wBC_Imp2R_Muon_{SET}_calib.txt
    @output plots {LFHCAL_WORK}/{WORK}/plots/refine2/Muon_{SET}
    {BUILD}/DataPrep -x -a -f -d 1 -S -i @input.root -k @input.prev \
        -o @output.root -O @output.plots -r @input.rundb

refine3-g2: refine2-g2
    @input root {LFHCAL_WORK}/{WORK}/selected/rawHGCROC_mipTrigg_wPedwMuon_wBC_Muon_{SET}.root
    @input prev {LFHCAL_WORK}/{WORK}/refine2/rawHGCROC_wPedwMuon_wBC_Imp2R_Muon_{SET}_calib.txt
    @input rundb {RUNDB}
    @output root {LFHCAL_WORK}/{WORK}/refine3/rawHGCROC_wPedwMuon_wBC_Imp3R_Muon_{SET}.root
    @output calib {LFHCAL_WORK}/{WORK}/refine3/rawHGCROC_wPedwMuon_wBC_Imp3R_Muon_{SET}_calib.txt
    @output plots {LFHCAL_WORK}/{WORK}/plots/refine3/Muon_{SET}
    {BUILD}/DataPrep -x -a -f -d 1 -S -i @input.root -k @input.prev \
        -o @output.root -O @output.plots -r @input.rundb

refine4-g2: refine3-g2
    @input root {LFHCAL_WORK}/{WORK}/selected/rawHGCROC_mipTrigg_wPedwMuon_wBC_Muon_{SET}.root
    @input prev {LFHCAL_WORK}/{WORK}/refine3/rawHGCROC_wPedwMuon_wBC_Imp3R_Muon_{SET}_calib.txt
    @input rundb {RUNDB}
    @output root {LFHCAL_WORK}/{WORK}/refine4/rawHGCROC_wPedwMuon_wBC_Imp4R_Muon_{SET}.root
    @output calib {LFHCAL_WORK}/{WORK}/refine4/rawHGCROC_wPedwMuon_wBC_Imp4R_Muon_{SET}_calib.txt
    @output plots {LFHCAL_WORK}/{WORK}/plots/refine4/Muon_{SET}
    {BUILD}/DataPrep -x -a -f -d 1 -S -i @input.root -k @input.prev \
        -o @output.root -O @output.plots -r @input.rundb

refine5-g2: refine4-g2
    @input root {LFHCAL_WORK}/{WORK}/selected/rawHGCROC_mipTrigg_wPedwMuon_wBC_Muon_{SET}.root
    @input prev {LFHCAL_WORK}/{WORK}/refine4/rawHGCROC_wPedwMuon_wBC_Imp4R_Muon_{SET}_calib.txt
    @input rundb {RUNDB}
    @output root {LFHCAL_WORK}/{WORK}/refine5/rawHGCROC_wPedwMuon_wBC_Imp5R_Muon_{SET}.root
    @output calib {LFHCAL_WORK}/{WORK}/refine5/rawHGCROC_wPedwMuon_wBC_Imp5R_Muon_{SET}_calib.txt
    @output plots {LFHCAL_WORK}/{WORK}/plots/refine5/Muon_{SET}
    {BUILD}/DataPrep -x -a -f -d 1 -S -i @input.root -k @input.prev \
        -o @output.root -O @output.plots -r @input.rundb

final-g2: refine5-g2
    @input root {LFHCAL_WORK}/{WORK}/refine5/rawHGCROC_wPedwMuon_wBC_Imp5R_Muon_{SET}.root
    @input calib {LFHCAL_WORK}/{WORK}/refine5/rawHGCROC_wPedwMuon_wBC_Imp5R_Muon_{SET}_calib.txt
    @output root {LFHCAL_WORK}/{WORK}/final/calib_Final_Muon_{SET}.root
    @output calib {LFHCAL_WORK}/{WORK}/final/calib_Final_Muon_{SET}_calib.txt
    ! /bin/mkdir -p {LFHCAL_WORK}/{WORK}/final && \
        /bin/cp @input.root @output.root && /bin/cp @input.calib @output.calib
