# Standalone Yallfile: edit the tables and run with yall-run.
@env CALWORK
@env LFHCAL_SOURCE
@env LFHCAL_RAW
@env EIC_SHELL
# ps-a2: legacy fitter, original boundary; 5 refinements.
# Native tasks: no Python calibration runner and no automatic submission.
# Pedestal evidence: inferred
# DRAFT: pedestal association inferred
# DRAFT: ToA choice not supplied for this named set
campaign lfhcal-2026-ps-a2-legacy-original
backend condor
%account-provenance off
%cpus 1
%memory 8GB
%disk 16GB
%time 10h
%getenv true
@set WORK {CALWORK}/ps-a2
@set SOURCE {LFHCAL_SOURCE}
@set BUILD {CALWORK}/ps-a2/build
@set CFG {SOURCE}/configs/TB2026
@set RAW {LFHCAL_RAW}/ps-2026/raw
%wrapper {SOURCE}/examples/yall/calibration-2026/run-in-eic-shell.sh {EIC_SHELL} {SOURCE}/examples/yall/calibration-2026/in-calibration-build.sh {BUILD}

# File role and run number drive conversion. Leading zeros are filenames.
@table runs type run:
    pedestal  120
    muon      121
    muon      122
    muon      123
    muon      124
    muon      125
    muon      126

# Each sample has exactly one pedestal. Scan samples remain separate.
@table pairs ped sample:
    120 Muon_FullSetA_2

build:
    %cpus 4
    %time 2h
    @input cmake {SOURCE}/NewStructure/CMakeLists.txt
    @input decoder {SOURCE}/NewStructure/h2g_decode/CMakeLists.txt
    @output convert {BUILD}/Convert
    @output dataprep {BUILD}/DataPrep
    @output library {BUILD}/libLFHCAL.so
    ! cmake -S {SOURCE}/NewStructure -B {BUILD} -DCMAKE_BUILD_TYPE=Release && cmake --build {BUILD} --target Convert DataPrep -j 4

prepare: build
    /bin/mkdir -p {WORK}/converted {WORK}/pedestal {WORK}/transfer {WORK}/mip {WORK}/select {WORK}/final {WORK}/refine1 {WORK}/refine2 {WORK}/refine3 {WORK}/refine4 {WORK}/refine5 {WORK}/plots/pedestal {WORK}/plots/transfer {WORK}/plots/mip {WORK}/plots/refine1 {WORK}/plots/refine2 {WORK}/plots/refine3 {WORK}/plots/refine4 {WORK}/plots/refine5

convert-{type}-{run}: prepare
    @each type run in runs
    %memory 4GB
    %time 24h
    @input raw {RAW}/Run{run}.h2g
    @input mapping {CFG}/mapping_HGCROC_PST10TB_sumV2_default_inv.csv
    @input rundb {CFG}/DataTakingDB_TBPST10_202604_HGCROC.csv
    @output root {WORK}/converted/rawHGCROC_{run}.root
    {BUILD}/Convert -d 0 -f -w -c @input.raw -o @output.root -m @input.mapping -r @input.rundb

pedestal-{ped}: convert-pedestal-{ped}
    @each ped in pairs.ped
    @input raw {WORK}/converted/rawHGCROC_{ped}.root
    @input rundb {CFG}/DataTakingDB_TBPST10_202604_HGCROC.csv
    @output root {WORK}/pedestal/rawHGCROC_wPed_{ped}.root
    @output calib {WORK}/pedestal/rawHGCROC_wPed_{ped}_calib.txt
    @output hists {WORK}/pedestal/rawHGCROC_wPed_{ped}_Hists.root
    @output plots {WORK}/plots/pedestal/Run{ped}
    {BUILD}/DataPrep -a -d 1 -p -i @input.raw -f -o @output.root -O @output.plots -r @input.rundb -F png

merge-{type}: convert-{type}-{run}
    @each type muon
    @input parts {WORK}/converted/rawHGCROC_{run}.root
    @output root {WORK}/converted/rawHGCROC_Muon_FullSetA_2.root
    hadd -f @output.root @input.parts

# -P transfers pedestal constants; -B loads the bad-channel map; -G loads ToA offsets.
transfer-{ped}-{sample}: merge-muon pedestal-{ped}
    @each ped sample in pairs
    @input pedestal {WORK}/pedestal/rawHGCROC_wPed_{ped}.root
    @input raw {WORK}/converted/rawHGCROC_{sample}.root
    @input bad {CFG}/badChannel_HGCROC_PSTB2026_dummy.txt
    @input rundb {CFG}/DataTakingDB_TBPST10_202604_HGCROC.csv
    @input toa {CFG}/UNASSIGNED_TOA_ps-a2.csv
    @output root {WORK}/transfer/rawHGCROC_wPed_wBC_{sample}.root
    @output plots {WORK}/plots/transfer/{sample}
    {BUILD}/DataPrep -d 1 -e -f -P @input.pedestal -i @input.raw -o @output.root -O @output.plots -r @input.rundb -B @input.bad -G @input.toa -F png

mip-{ped}-{sample}: transfer-{ped}-{sample}
    @input root {WORK}/transfer/rawHGCROC_wPed_wBC_{sample}.root
    @input rundb {CFG}/DataTakingDB_TBPST10_202604_HGCROC.csv
    @output root {WORK}/mip/rawHGCROC_wPedwMuon_wBC_{sample}.root
    @output calib {WORK}/mip/rawHGCROC_wPedwMuon_wBC_{sample}_calib.txt
    @output hists {WORK}/mip/rawHGCROC_wPedwMuon_wBC_{sample}_Hists.root
    @output plots {WORK}/plots/mip/{sample}
    {BUILD}/DataPrep -a -f -d 1 -e -s -i @input.root -o @output.root -O @output.plots -r @input.rundb -F png

select-{ped}-{sample}: mip-{ped}-{sample}
    @input root {WORK}/mip/rawHGCROC_wPedwMuon_wBC_{sample}.root
    @output root {WORK}/select/rawHGCROC_mipTrigg_wPedwMuon_wBC_{sample}.root
    {BUILD}/DataPrep -f -d 1 -X -i @input.root -o @output.root

# Every refinement reads the same selected event file.
# -S refits the MIP; -x avoids another event-tree copy; -k carries the preceding constants.
refine1-{ped}-{sample}: select-{ped}-{sample}
    @input root {WORK}/select/rawHGCROC_mipTrigg_wPedwMuon_wBC_{sample}.root
    @input rundb {CFG}/DataTakingDB_TBPST10_202604_HGCROC.csv
    @output root {WORK}/refine1/rawHGCROC_wPedwMuon_wBC_ImpR_{sample}.root
    @output calib {WORK}/refine1/rawHGCROC_wPedwMuon_wBC_ImpR_{sample}_calib.txt
    @output hists {WORK}/refine1/rawHGCROC_wPedwMuon_wBC_ImpR_{sample}_Hists.root
    @output plots {WORK}/plots/refine1/{sample}
    {BUILD}/DataPrep -x -a -f -d 1 -S -i @input.root -o @output.root -O @output.plots -r @input.rundb -F png

refine2-{ped}-{sample}: refine1-{ped}-{sample}
    @input root {WORK}/select/rawHGCROC_mipTrigg_wPedwMuon_wBC_{sample}.root
    @input rundb {CFG}/DataTakingDB_TBPST10_202604_HGCROC.csv
    @input calib {WORK}/refine1/rawHGCROC_wPedwMuon_wBC_ImpR_{sample}_calib.txt
    @output root {WORK}/refine2/rawHGCROC_wPedwMuon_wBC_Imp2R_{sample}.root
    @output calib {WORK}/refine2/rawHGCROC_wPedwMuon_wBC_Imp2R_{sample}_calib.txt
    @output hists {WORK}/refine2/rawHGCROC_wPedwMuon_wBC_Imp2R_{sample}_Hists.root
    @output plots {WORK}/plots/refine2/{sample}
    {BUILD}/DataPrep -x -a -f -d 1 -S -i @input.root -k @input.calib -o @output.root -O @output.plots -r @input.rundb -F png

refine3-{ped}-{sample}: refine2-{ped}-{sample}
    @input root {WORK}/select/rawHGCROC_mipTrigg_wPedwMuon_wBC_{sample}.root
    @input rundb {CFG}/DataTakingDB_TBPST10_202604_HGCROC.csv
    @input calib {WORK}/refine2/rawHGCROC_wPedwMuon_wBC_Imp2R_{sample}_calib.txt
    @output root {WORK}/refine3/rawHGCROC_wPedwMuon_wBC_Imp3R_{sample}.root
    @output calib {WORK}/refine3/rawHGCROC_wPedwMuon_wBC_Imp3R_{sample}_calib.txt
    @output hists {WORK}/refine3/rawHGCROC_wPedwMuon_wBC_Imp3R_{sample}_Hists.root
    @output plots {WORK}/plots/refine3/{sample}
    {BUILD}/DataPrep -x -a -f -d 1 -S -i @input.root -k @input.calib -o @output.root -O @output.plots -r @input.rundb -F png

refine4-{ped}-{sample}: refine3-{ped}-{sample}
    @input root {WORK}/select/rawHGCROC_mipTrigg_wPedwMuon_wBC_{sample}.root
    @input rundb {CFG}/DataTakingDB_TBPST10_202604_HGCROC.csv
    @input calib {WORK}/refine3/rawHGCROC_wPedwMuon_wBC_Imp3R_{sample}_calib.txt
    @output root {WORK}/refine4/rawHGCROC_wPedwMuon_wBC_Imp4R_{sample}.root
    @output calib {WORK}/refine4/rawHGCROC_wPedwMuon_wBC_Imp4R_{sample}_calib.txt
    @output hists {WORK}/refine4/rawHGCROC_wPedwMuon_wBC_Imp4R_{sample}_Hists.root
    @output plots {WORK}/plots/refine4/{sample}
    {BUILD}/DataPrep -x -a -f -d 1 -S -i @input.root -k @input.calib -o @output.root -O @output.plots -r @input.rundb -F png

refine5-{ped}-{sample}: refine4-{ped}-{sample}
    @input root {WORK}/select/rawHGCROC_mipTrigg_wPedwMuon_wBC_{sample}.root
    @input rundb {CFG}/DataTakingDB_TBPST10_202604_HGCROC.csv
    @input calib {WORK}/refine4/rawHGCROC_wPedwMuon_wBC_Imp4R_{sample}_calib.txt
    @output root {WORK}/refine5/rawHGCROC_wPedwMuon_wBC_Imp5R_{sample}.root
    @output calib {WORK}/refine5/rawHGCROC_wPedwMuon_wBC_Imp5R_{sample}_calib.txt
    @output hists {WORK}/refine5/rawHGCROC_wPedwMuon_wBC_Imp5R_{sample}_Hists.root
    @output plots {WORK}/plots/refine5/{sample}
    {BUILD}/DataPrep -x -a -f -d 1 -S -i @input.root -k @input.calib -o @output.root -O @output.plots -r @input.rundb -F png

final-{ped}-{sample}: refine5-{ped}-{sample}
    @input root {WORK}/refine5/rawHGCROC_wPedwMuon_wBC_Imp5R_{sample}.root
    @input calib {WORK}/refine5/rawHGCROC_wPedwMuon_wBC_Imp5R_{sample}_calib.txt
    @output root {WORK}/final/calib_Final_{sample}.root
    @output calib {WORK}/final/calib_Final_{sample}_calib.txt
    ! /bin/cp @input.root @output.root && /bin/cp @input.calib @output.calib

