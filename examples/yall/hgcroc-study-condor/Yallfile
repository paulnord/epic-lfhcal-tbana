campaign lfhcal-hgcroc-study-condor
backend condor

@env EIC_SHELL
%cpus 1
%memory 4GB
%disk 4GB
# Per-job runtime request; Condor uses site-defined MaxRuntime, not allowed_execute_duration.
%time 2h
%getenv true
%wrapper ../../../tools/run-in-eic-shell.sh {EIC_SHELL} /usr/bin/env ROOT_MAX_THREADS=1 OMP_NUM_THREADS=1

study:
    @input raw input.root
    @output root hgcroc-study-condor.root
    @output plots hgcroc-study-condor-plots
    ../../../NewStructure/build/HGCROCStudy -d 1 -L 1000 -w \
        -i @input.raw -o @output.root -O @output.plots
