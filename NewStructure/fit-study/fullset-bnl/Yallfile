campaign lfhcal-tb2026-legacy-grid-fullset-refine5
backend condor

# Replay only refine5 for every completed adaptive FullSet production.
# Inputs are read in place; no selected ROOT file is copied.
@env LFHCAL_WORK
@env LFHCAL_FULLSET_OUT
@env EIC_SHELL

@set BUILD ../../../NewStructure/build
@set RUNDB ../../../configs/TB2026/DataTakingDB_TBSPSH2_202605_HGCROC.csv

%cpus 1
%memory 4GB
%disk 8GB
%time 2h
%getenv true
%wrapper ../../../tools/run-in-eic-shell.sh {EIC_SHELL} /usr/bin/env ROOT_MAX_THREADS=1 OMP_NUM_THREADS=1
%preflight python3 prepare.py {LFHCAL_FULLSET_OUT}

refine5-b1:
    @input selected {LFHCAL_WORK}/adaptive-fullset-b1-repro/selected/rawHGCROC_mipTrigg_wPedwMuon_wBC_Muon_FullSetB_1.root
    @input prev {LFHCAL_WORK}/adaptive-fullset-b1-repro/refine4/rawHGCROC_wPedwMuon_wBC_Imp4R_Muon_FullSetB_1_calib.txt
    @input rundb {RUNDB}
    @output root {LFHCAL_FULLSET_OUT}/b1/refine5/rawHGCROC_wPedwMuon_wBC_Imp5R_Muon_FullSetB_1.root
    @output calib {LFHCAL_FULLSET_OUT}/b1/refine5/rawHGCROC_wPedwMuon_wBC_Imp5R_Muon_FullSetB_1_calib.txt
    @output hists {LFHCAL_FULLSET_OUT}/b1/refine5/rawHGCROC_wPedwMuon_wBC_Imp5R_Muon_FullSetB_1_Hists.root
    @output plots {LFHCAL_FULLSET_OUT}/b1/plots/refine5/Muon_FullSetB_1
    {BUILD}/DataPrep -x -a -f -d 1 -S -i @input.selected -k @input.prev \
        -o @output.root -O @output.plots -r @input.rundb

compare-b1: refine5-b1
    @input baseline_calib {LFHCAL_WORK}/adaptive-fullset-b1-repro/refine5/rawHGCROC_wPedwMuon_wBC_Imp5R_Muon_FullSetB_1_calib.txt
    @input baseline_hists {LFHCAL_WORK}/adaptive-fullset-b1-repro/refine5/rawHGCROC_wPedwMuon_wBC_Imp5R_Muon_FullSetB_1_Hists.root
    @input candidate_calib {LFHCAL_FULLSET_OUT}/b1/refine5/rawHGCROC_wPedwMuon_wBC_Imp5R_Muon_FullSetB_1_calib.txt
    @input candidate_hists {LFHCAL_FULLSET_OUT}/b1/refine5/rawHGCROC_wPedwMuon_wBC_Imp5R_Muon_FullSetB_1_Hists.root
    @output summary {LFHCAL_FULLSET_OUT}/b1/comparison.json
    python3 ../e1-bnl/compare.py --baseline-calib @input.baseline_calib \
        --candidate-calib @input.candidate_calib \
        --baseline-hists @input.baseline_hists \
        --candidate-hists @input.candidate_hists --out @output.summary

